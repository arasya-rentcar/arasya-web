# Public build settings for production (not secrets: these values end up in the page).
# Booking-form leads are also posted to {PUBLIC_LEADS_API}/api/v1/public/leads.
PUBLIC_LEADS_API=https://api.haikuy.com
# Booking-form place suggestions + map picker: OpenStreetMap (no key). Vercel
# environment variables override this file (see .env.example to switch to Google).
PUBLIC_MAPS_PROVIDER=osm
