# Public build settings for production (not secrets: these values end up in the page).
# Booking-form leads are also posted to {PUBLIC_LEADS_API}/api/v1/public/leads.
PUBLIC_LEADS_API=https://api.haikuy.com
# Booking-form place suggestions + map picker: off (plain text fields). OSM was
# turned off on 7 Oct 2026: its places/addresses were too inaccurate for
# pick-ups. Vercel environment variables override this file (see .env.example
# to switch to Google).
PUBLIC_MAPS_PROVIDER=off
