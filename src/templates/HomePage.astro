---
import Base from '../layouts/Base.astro';
import HeroShowroom from '../components/HeroShowroom.astro';
import CarCard from '../components/CarCard.astro';
import TrustRow from '../components/TrustRow.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import FraudNotice from '../components/FraudNotice.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import UnitRequest from '../components/UnitRequest.astro';
import { getContent, hasEn } from '../lib/content';
import { rupiah } from '../lib/format';
import { listJoin, type Lang } from '../lib/i18n';
import { paths } from '../lib/paths';
import { faqPage } from '../lib/schema';
import { byPopularity, cityIsIndexable } from '../lib/quality';
import { carImage, photo } from '../lib/images';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const { settings, home, cars, cities, services, posts } = await getContent(lang);
const idHome = (await getContent('id')).home;
const priced = cars.filter((c) => c.priceCity);
const cheapest = priced.reduce((m, c) => (c.priceCity! < m.priceCity! ? c : m), priced[0]);
const cheapestAllIn = Math.min(...cars.map((c) => c.priceAllIn || Infinity));
const liveCities = cities.filter(cityIsIndexable);
const featured = home.featuredCars?.length ? home.featuredCars : cars.slice(0, 4);
const serviceText: Record<string, string> = en
  ? {
      corporate: 'Staff transport and business guests, invoiced and paid to the company account.',
      travel: 'Door-to-door private transfers to the airport and between cities, one car for your group.',
      wedding: 'Clean, elegant cars for the ceremony and reception, with a well-dressed driver.',
    }
  : {
      wedding: 'Mobil bersih dan elegan untuk akad dan resepsi, dengan driver rapi.',
      corporate: 'Transportasi karyawan dan tamu bisnis, pembayaran ke rekening perusahaan.',
      travel: 'Carter door to door ke bandara dan antar kota, satu mobil untuk rombongan Anda.',
    };
const cityList = listJoin(liveCities.map((c) => c.name), lang);
// Six cities get a card (the busiest first); the rest are listed as links.
const cityCards = byPopularity(liveCities).slice(0, 6);
const cityMore = liveCities.filter((c) => !cityCards.includes(c));
// Plain questions people ask before renting; the answers are built from live data
// so prices never drift. Rendered as an FAQ (with FAQPage JSON-LD), which is what
// search snippets and AI answer engines quote.
const bank = settings.bankAccounts[0];
const homeFaq = en ? [
  {
    question: 'How much does it cost to rent a car with a driver from Arasya?',
    answer: `From ${rupiah(cheapest.priceCity!)} for 12 hours in town in a ${cheapest.name}, excluding fuel, tolls, parking and the driver’s meals.${Number.isFinite(cheapestAllIn) ? ` All-in packages that include fuel, tolls and the driver’s meals start at ${rupiah(cheapestAllIn)}.` : ''} Every car’s rate is on the fleet page.`,
  },
  ...(cityList ? [{ question: 'Which cities does Arasya serve?', answer: `We have local pages for ${cityList}. Beyond those, we drive between cities and across provinces to wherever you need to go; just ask.` }] : []),
  { question: 'Can I rent a car without a driver?', answer: 'No. Every Arasya car comes with a professional driver who knows the local roads, so you never deal with traffic, parking or directions yourself.' },
  { question: 'How do I book?', answer: `Send your date, pick-up point and destination on WhatsApp to ${settings.phones[0]}. Our team confirms the car, the rate and the pick-up before the booking is final. We reply on WhatsApp 24 hours a day.` },
  ...(settings.paymentTerms ? [{ question: 'How do I pay?', answer: `${settings.paymentTerms}${bank ? ` Official account: ${bank.bank} ${bank.number} ${bank.owner}.` : ''}` }] : []),
] : [
  {
    question: 'Berapa harga sewa mobil dengan driver di Arasya?',
    answer: `Mulai ${rupiah(cheapest.priceCity!)} per 12 jam dalam kota untuk ${cheapest.name}, belum termasuk BBM, tol, parkir, dan makan driver.${Number.isFinite(cheapestAllIn) ? ` Paket all-in yang sudah termasuk BBM, tol, dan makan driver mulai ${rupiah(cheapestAllIn)}.` : ''} Tarif lengkap per unit ada di halaman armada.`,
  },
  ...(cityList ? [{ question: 'Arasya melayani kota mana saja?', answer: `Kami punya layanan lokal di ${cityList}. Di luar itu, kami melayani perjalanan antar kota dan antarprovinsi ke mana pun tujuan Anda; tanyakan saja ke admin.` }] : []),
  { question: 'Bagaimana cara memesan?', answer: `Kirim tanggal, titik jemput, dan tujuan lewat WhatsApp ${settings.phones[0]}. Admin mengonfirmasi unit, tarif, dan titik jemput sebelum pemesanan dipastikan. Admin siaga 24 jam.` },
  ...(settings.paymentTerms ? [{ question: 'Bagaimana ketentuan pembayarannya?', answer: `${settings.paymentTerms}${bank ? ` Rekening resmi: ${bank.bank} ${bank.number} ${bank.owner}.` : ''}` }] : []),
];
---
<Base title={home.seo?.title || settings.brandName} description={home.seo?.description || ''} path={paths.home(lang)} alternates={hasEn.home(idHome) ? { id: '/', en: '/en' } : {}} waRef={en ? 'EN-HOME-fab' : 'HOME-fab'} jsonld={[faqPage(homeFaq)]}>
   <HeroShowroom hero={home.hero} settings={settings} cars={cars} refCode={en ? 'EN-HOME-booking' : 'HOME-booking'} fromPrice={cheapest?.priceCity || undefined} />

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div class="stack"><span class="eyebrow">{en ? 'Fleet' : 'Armada'}</span><h2>{en ? 'Choose a car for your trip' : 'Pilih mobil untuk perjalanan Anda'}</h2><p class="intro">{en ? 'From family seven-seaters to group vans and luxury MPVs. Every car comes with a driver.' : 'Dari MPV keluarga sampai van rombongan dan MPV mewah. Semua disewakan bersama driver.'}</p></div>
        <a class="link-more" href={paths.fleet(lang)}>{en ? 'See more cars →' : 'Lihat unit lainnya →'}</a>
      </div>
      <div class="grid grid-4">
        {featured.map((c) => <CarCard car={c} settings={settings} refPrefix={en ? 'EN-HOME' : 'HOME'} />)}
      </div>
      {settings.rateNotes?.city && <p class="note muted">{settings.rateNotes.city}</p>}
      <UnitRequest settings={settings} waRef={en ? 'EN-HOME-request' : 'HOME-request'} />
    </div>
  </section>

  <section class="section tint">
    <div class="wrap">
      <div class="section-head"><div class="stack"><span class="eyebrow">{en ? 'Services' : 'Layanan'}</span><h2>{en ? 'One team for every kind of trip' : 'Satu admin untuk semua kebutuhan perjalanan'}</h2></div></div>
      <div class="grid grid-3">
        {services.map((s) => (
          <a class={`svc svc-${s.template}`} href={paths.service(s, lang)}>
            <span class="svc-label">{s.navLabel}</span>
            <h3>{s.hero.title} {s.hero.titleAccent}</h3>
            <p>{serviceText[s.template] || s.hero.lead}</p>
            <span class="go">{en ? 'Learn more' : 'Selengkapnya'} <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <TrustRow items={settings.trust} />

  {liveCities.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-head"><div class="stack"><span class="eyebrow">{en ? 'Cities' : 'Kota layanan'}</span><h2>{en ? 'Car rental by city' : 'Sewa mobil per kota'}</h2></div><a class="link-more" href={paths.cities(lang)}>{en ? 'All cities →' : 'Semua kota →'}</a></div>
        <div class="grid grid-3">
          {cityCards.map((c) => {
            const dest = c.destinations?.find((d) => d.image?.asset || d.imagePath);
            const img = dest ? photo(dest.image, dest.imagePath, 800) : null;
            const car = img ? null : carImage(c.hero.car);
            return (
              <a class="city" href={paths.city(c, lang)}>
                {img && <img src={img.src} srcset={img.srcset} sizes="(max-width: 560px) 92vw, 380px" alt="" loading="lazy" width="800" height="450" />}
                {car && <span class="city-car"><img src={car.src} srcset={car.srcset} sizes="380px" alt="" loading="lazy" width="960" height="600" /></span>}
                <div><h3>{en ? `Car rental in ${c.name}` : `Sewa mobil ${c.name}`}</h3><p>{c.areaServed?.join(' · ')}</p></div>
              </a>
            );
          })}
        </div>
        {cityMore.length > 0 && (
          <p class="more-cities">
            <span>{en ? 'Also in' : 'Juga di'}</span>
            {cityMore.map((c) => <a href={paths.city(c, lang)}>{c.name}</a>)}
          </p>
        )}
        <p class="anywhere muted">{en ? "Don't see your city? We also drive between cities and across provinces, wherever you need to go." : 'Kota Anda belum ada di daftar? Kami tetap melayani perjalanan antar kota dan antarprovinsi, ke mana pun tujuan Anda.'}</p>
      </div>
    </section>
  )}

  <Testimonials items={settings.testimonials} />

  {posts.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <div class="section-head"><div class="stack"><span class="eyebrow">Blog</span><h2>Panduan perjalanan</h2></div><a class="link-more" href={paths.blog()}>Semua artikel →</a></div>
        <div class:list={['grid', posts.length >= 3 ? 'grid-3' : 'grid-1']}>
          {posts.slice(0, 3).map((p) => {
            const cover = posts.length < 3 ? photo(p.cover, p.coverPath, 800) : null;
            return (
              <a class:list={['post', { wide: !!cover }]} href={`/blog/${p.slug.current}`}>
                {cover && <img src={cover.src} srcset={cover.srcset} sizes="(max-width: 760px) 92vw, 480px" alt="" loading="lazy" width="800" height="450" />}
                <div class="post-body">
                  <span class="eyebrow">{p.category}</span>
                  <h3>{p.title}</h3>
                  <p>{p.excerpt}</p>
                  <span class="go">Baca artikel <Icon name="arrow" size={16} /></span>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <section class="section" style="padding-bottom:0"><div class="wrap"><FraudNotice settings={settings} /></div></section>

  <Faq items={homeFaq} />

  {en ? (
    <CtaBand settings={settings} title="Not sure which car fits?" text="Tell us how many people are travelling and where to, and we'll suggest a car and quote the rate." message="Hi Arasya, could you help me choose a car? Passengers: …, destination: …" waRef="EN-HOME-band" />
  ) : (
    <CtaBand settings={settings} title="Belum yakin unit mana yang cocok?" text="Kirim jumlah penumpang dan tujuan Anda, admin kami bantu pilihkan unit dan tarifnya." message="Halo Arasya, saya mau dibantu pilih unit. Penumpang: …, tujuan: …" waRef="HOME-band" />
  )}
</Base>

<style>
  .note { margin-top: 16px; font-size: 0.9rem; }
  .svc { display: grid; gap: 10px; align-content: start; padding: 24px; border-radius: var(--radius); background: #fff; text-decoration: none; color: var(--ink); border: 1px solid var(--line); transition: border-color 0.15s, transform 0.15s; }
  .svc:hover { border-color: var(--blue); color: var(--ink); transform: translateY(-2px); }
  .svc-label { font: 700 0.75rem/1 var(--text); letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
  .svc-wedding .svc-label { color: #a87b1f; }
  .svc p { color: var(--soft); font-size: 0.95rem; }
  .go { display: inline-flex; align-items: center; gap: 6px; font: 700 0.9rem/1 var(--display); color: var(--blue); margin-top: 4px; }
  .city { display: grid; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); text-decoration: none; color: var(--ink); }
  .city > img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .city-car { aspect-ratio: 16 / 9; background: var(--sky); display: flex; align-items: flex-end; justify-content: center; padding: 16px 24px 8px; }
  .city-car img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  .city div { padding: 16px; display: grid; gap: 4px; }
  .city p, .post p { color: var(--soft); font-size: 0.95rem; }
  .post { display: grid; background: #fff; border-radius: var(--radius); text-decoration: none; color: var(--ink); border: 1px solid var(--line); overflow: hidden; }
  .post-body { display: grid; gap: 8px; align-content: start; padding: 22px; }
  .post.wide { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); align-items: stretch; }
  .post.wide img { width: 100%; height: 100%; min-height: 220px; max-height: 300px; object-fit: cover; }
  .post.wide .post-body { align-content: center; padding: 28px; }
  .grid-1 { grid-template-columns: 1fr; }
  .more-cities { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 20px; }
  .more-cities span { font-weight: 700; color: var(--deep); margin-right: 4px; }
  .more-cities a { padding: 7px 13px; border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.9rem; color: var(--deep); background: #fff; }
  .more-cities a:hover { border-color: var(--blue); color: var(--blue); }
  .anywhere { margin-top: 12px; font-size: 0.93rem; }
  @media (max-width: 760px) { .post.wide { grid-template-columns: 1fr; } .post.wide img { min-height: 0; aspect-ratio: 16 / 9; } }
  .post:hover, .city:hover { border-color: var(--blue); color: var(--ink); }
</style>
