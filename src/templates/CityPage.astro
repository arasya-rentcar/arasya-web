---
import Base from '../layouts/Base.astro';
import { withPolicy } from '../lib/faq';
import HeroShowroom from '../components/HeroShowroom.astro';
import TrustRow from '../components/TrustRow.astro';
import Testimonials from '../components/Testimonials.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import PortableText from '../components/PortableText.astro';
import Icon from '../components/Icon.astro';
import FraudNotice from '../components/FraudNotice.astro';
import PolicyNotice from '../components/PolicyNotice.astro';
import RateNotes from '../components/RateNotes.astro';
import { getContent, type City } from '../lib/content';
import { rupiah } from '../lib/format';
import { ui, type Lang } from '../lib/i18n';
import { photo } from '../lib/images';
import { paths, type Alternates } from '../lib/paths';
import { refSlug, waHref } from '../lib/wa';
import { cityIsIndexable } from '../lib/quality';
import { breadcrumbs, cityService, faqPage } from '../lib/schema';
import { cheapest, cityTables, isAllInZone, rate, surchargesFor, type PriceZone } from '../lib/prices';

interface Props { city: City; lang: Lang; alternates: Alternates }
const { city, lang, alternates } = Astro.props;
const en = lang === 'en';
const t = ui(lang);
const { settings, cars, posts, services, prices } = await getContent(lang);
const site = (Astro.site?.toString() || settings.siteUrl).replace(/\/$/, '');
const path = paths.city(city, lang);
const crumbs = [{ name: t.home, path: paths.home(lang) }, { name: t.rentIn(city.name), path }];
const travel = services.find((s) => s.template === 'travel');
const originKey = travel?.origins?.find((o) => o.name === city.name || o.code === city.code)?.key;
const cityTransfers = (travel?.routes || []).filter((r) => r.origin === originKey && r.intro);
// The price list is keyed by the Indonesian document (slug and name), also on English pages.
const idCity = (await getContent('id')).cities.find((c) => c._id === city._id) || city;
const tables = cityTables(prices, idCity);
const slugs = cars.map((c) => c.slug.current);
const carName = (slug: string) => cars.find((c) => c.slug.current === slug)?.name || slug;
const driverLo = tables.driver ? cheapest(prices, [tables.driver], slugs) : null;
const allInLo = tables.allIn ? cheapest(prices, [tables.allIn], slugs) : null;
const rateTables = [tables.driver, tables.allIn].filter((z): z is PriceZone => !!z).map((zone) => ({
  zone,
  title: isAllInZone(zone) ? t.pkgAllInTitle : t.pkgDriverTitle,
  surcharges: isAllInZone(zone) ? surchargesFor(zone, idCity.name) : [],
}));
const cityPosts = posts.filter((p) => p.city?._id === city._id).slice(0, 3);
const sections = city.sections?.length ? city.sections : ['answer', 'fleet', 'trust', 'editorial', 'destinations', 'routes', 'testimonials', 'faq'];
const code = `${en ? 'EN-' : ''}${city.code}`;
const answer = t.cityAnswer({
  city: city.name,
  pickup: city.pickupPoints || city.name,
  driver: driverLo ? { price: rupiah(driverLo.amount), car: carName(driverLo.slug) } : undefined,
  allIn: allInLo ? { price: rupiah(allInLo.amount) } : undefined,
});
const quote = tables.quote;
const quoteAnswer = en
  ? `Car hire with a driver in ${city.name} is quoted per trip, in rupiah, based on your dates, hours and itinerary. Send us your plans on WhatsApp and we reply with a written quote before you pay. Pick-up from ${city.pickupPoints || city.name}.`
  : `Harga sewa mobil dengan supir di ${city.name} dihitung per perjalanan dalam Rupiah, menyesuaikan tanggal, durasi, dan itinerari. Kirim rencana perjalanan lewat WhatsApp; admin kami mengirim penawaran tertulis sebelum Anda membayar. Penjemputan di ${city.pickupPoints || city.name}.`;
const priceText = quote ? quoteAnswer : answer;
const bookingCars = quote ? (city.unitClasses || []).map((u) => ({ name: u.name }) as any) : cars;
const priceQuestion = en ? `How much is car rental with a driver in ${city.name}?` : `Berapa tarif sewa mobil dengan driver di ${city.name}?`;
const faq = [{ question: priceQuestion, answer: priceText }, ...(city.faq || []).filter((f) => f.question !== priceQuestion)];
const faqAll = withPolicy(faq, settings, lang);
const jsonld = [cityService(city, quote ? null : tables, prices, cars, site, settings, lang), faqPage(faqAll), breadcrumbs(site, crumbs)];
const waCity = en ? `Hi Arasya, I'd like to rent a car with a driver in ${city.name}.` : `Halo Arasya, saya mau sewa mobil di ${city.name}.`;
---
<Base title={city.seo?.title || t.rentIn(city.name)} description={city.seo?.description || ''} path={path} alternates={alternates} noindex={!cityIsIndexable(city)} jsonld={jsonld} waRef={`${code}-fab`} waMessage={waCity}>
  <HeroShowroom hero={city.hero} settings={settings} cars={bookingCars} refCode={`${code}-booking`} fromPrice={quote ? undefined : (driverLo || allInLo)?.amount} fromNote={driverLo ? t.heroFrom() : `${t.per12}, ${t.allIn}`} crumbs={crumbs} />

  {sections.map((s) => {
    // 'answer' is kept for older documents: its text now opens the rates section.
    if (s === 'fleet' && quote) return (
      <section class="section" id="tarif">
        <div class="wrap">
          <div class="section-head"><div class="stack"><span class="eyebrow">{en ? 'Cars & prices' : 'Unit & harga'}</span><h2>{en ? `Cars with a driver in ${city.name}` : `Pilihan mobil dengan supir di ${city.name}`}</h2><p class="intro">{quoteAnswer}</p></div></div>
          <div class="grid grid-3">
            {(city.unitClasses || []).map((u) => (
              <article class="uclass">
                <h3>{u.name}</h3>
                <dl>
                  {u.seats && <div><dt>{en ? 'Seats' : 'Kapasitas'}</dt><dd>{u.seats}</dd></div>}
                  {u.luggage && <div><dt>{en ? 'Luggage' : 'Bagasi'}</dt><dd>{u.luggage}</dd></div>}
                </dl>
                {u.useCase && <p class="muted">{u.useCase}</p>}
                <a class="btn btn-outline" href={waHref(settings.waPhone, en ? `Hi Arasya, I'd like a quote for a ${u.name} with driver in ${city.name}. Dates: …, passengers: …` : `Halo Arasya, saya mau minta penawaran ${u.name} dengan supir di ${city.name}. Tanggal: …, jumlah penumpang: …`, `${code}-${refSlug(u.name)}`)} data-cta={`quote-${refSlug(u.name)}`} rel="nofollow"><Icon name="wa" />{en ? 'Request a quote' : 'Minta penawaran'}</a>
              </article>
            ))}
          </div>
        </div>
      </section>
    );
    // Domestic cities: the official tables of the published price list (car + driver, all-in).
    if (s === 'fleet') return (
      <section class="section" id="tarif">
        <div class="wrap">
          <div class="section-head"><div class="stack"><span class="eyebrow">{t.cityRatesEyebrow(city.name)}</span><h2>{t.cityRatesTitle(city.name)}</h2><p class="intro">{answer}</p></div><a class="link-more" href={paths.fleet(lang)}>{t.compareCars}</a></div>
          <div class="rate-tables">
            {rateTables.map(({ zone, title, surcharges }) => (
              <div class="rate-block">
                <h3>{title}</h3>
                <div class="table-wrap">
                  <table class="rates">
                    <caption class="sr-only">{t.tableCaption(title, city.name)}</caption>
                    <thead><tr><th scope="col">{t.colCar}</th><th scope="col">{t.col12h}</th><th scope="col">{t.colFullday}</th></tr></thead>
                    <tbody>
                      {cars.map((c) => {
                        const h12 = rate(prices, c.slug.current, zone, '12H');
                        const full = rate(prices, c.slug.current, zone, 'FULLDAY');
                        return (
                          <tr>
                            <th scope="row"><a href={paths.car(c.slug.current, lang)}>{c.name}</a>{c.capacity && <small>{t.seats(c.capacity)}</small>}</th>
                            {h12 == null && full == null
                              ? <td class="ask" colspan="2">{t.askAdmin}</td>
                              : <><td class="num">{h12 ? rupiah(h12) : t.askAdmin}</td><td class="num">{full ? rupiah(full) : t.askAdmin}</td></>}
                          </tr>
                        );
                      })}
                    </tbody>
                  </table>
                </div>
                <RateNotes prices={prices} lang={lang} zone={zone} surcharges={surcharges} cityName={city.name} />
              </div>
            ))}
          </div>
          {rateTables.length > 0 && <div class="shared-notes"><RateNotes prices={prices} lang={lang} shared /></div>}
        </div>
      </section>
    );
    if (s === 'trust') return <TrustRow items={city.trust?.length ? city.trust : settings.trust} title={en ? `Why rent with Arasya in ${city.name}` : `Kenapa sewa mobil di ${city.name} bersama Arasya`} />;
    if (s === 'editorial' && city.editorial) return (
      <section class="section">
        <div class="wrap editorial">
          <div class="stack">
            {city.editorial.eyebrow && <span class="eyebrow">{city.editorial.eyebrow}</span>}
            <h2>{city.editorial.title}</h2>
            {city.editorial.lead && <p class="lead">{city.editorial.lead}</p>}
          </div>
          <PortableText value={city.editorial.body} />
        </div>
      </section>
    );
    if (s === 'destinations' && city.destinations?.length) return (
      <section class="section tint">
        <div class="wrap">
          <div class="section-head"><div class="stack"><span class="eyebrow">{en ? 'Places to go' : 'Destinasi'}</span><h2>{en ? `Popular trips around ${city.name}` : `Tujuan populer di sekitar ${city.name}`}</h2><p class="muted">{en ? 'Tell us where you want to go; your driver plans the best way there.' : 'Sampaikan tujuan Anda, supir kami yang mengatur rute terbaiknya.'}</p></div></div>
          <div class="grid grid-3">
            {city.destinations.map((d) => {
              const img = photo(d.image, d.imagePath, 800);
              return (
                <article class="dest">
                  {img && <img src={img.src} srcset={img.srcset} sizes="(max-width: 560px) 92vw, 380px" alt={d.name} loading="lazy" width="800" height="450" />}
                  <div class="stack">
                    {d.area && <span class="area"><Icon name="pin" size={14} />{d.area}</span>}
                    <h3>{d.name}</h3>
                    {d.text && <p>{d.text}</p>}
                    {d.credit && <small>{d.creditUrl ? <a href={d.creditUrl} rel="noopener nofollow">{d.credit}</a> : d.credit}</small>}
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    );
    if (s === 'routes' && city.routes?.length) return (
      <section class="section">
        <div class="wrap">
          <div class="section-head"><div class="stack"><span class="eyebrow">{en ? `From ${city.name}` : `Rute dari ${city.name}`}</span><h2>{en ? 'Popular trips and driving times' : 'Contoh rute populer'}</h2><p class="muted">{en ? `Just examples: we drive from ${city.name} to anywhere you need to go.` : `Hanya contoh; dari ${city.name} kami melayani perjalanan ke mana pun tujuan Anda.`}</p></div>{travel && !quote && <a class="link-more" href={paths.service(travel, lang)}>{en ? 'Intercity transfer rates →' : 'Tarif travel antar kota →'}</a>}</div>
          <div class="grid grid-2">
            {city.routes.map((r) => (
              <div class="route">
                <Icon name="route" size={22} />
                <div><h3>{r.to.includes('→') ? r.to : `${city.name} → ${r.to}`}</h3>{r.duration && <p class="dur num">{r.duration}</p>}{r.note && <p class="muted">{r.note}</p>}</div>
              </div>
            ))}
          </div>
          {cityTransfers.length > 0 && travel && (
            <p class="transfers"><b>{en ? `Private transfers from ${city.name}:` : `Travel carter dari ${city.name}:`}</b> {cityTransfers.map((r, i) => <>{i > 0 && ' · '}<a href={paths.route(travel, r, lang)}>{r.destName}</a></>)}</p>
          )}
        </div>
      </section>
    );
    if (s === 'testimonials') return <Testimonials items={settings.testimonials} />;
    if (s === 'faq') return (
      <>
        <section class="section" style="padding-bottom:0"><div class="wrap"><div class="notices"><PolicyNotice settings={settings} /><FraudNotice settings={settings} /></div></div></section>
        <Faq items={faqAll} title={en ? `Renting a car in ${city.name}: questions` : `Tanya jawab sewa mobil ${city.name}`} />
      </>
    );
    return null;
  })}

  {cityPosts.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <div class="section-head"><div class="stack"><span class="eyebrow">Panduan {city.name}</span><h2>Bacaan sebelum berangkat</h2></div></div>
        <div class="grid grid-3">
          {cityPosts.map((p) => <a class="post" href={`/blog/${p.slug.current}`}><span class="eyebrow">{p.category}</span><h3>{p.title}</h3><p class="muted">{p.excerpt}</p></a>)}
        </div>
      </div>
    </section>
  )}

  {en ? (
    <CtaBand settings={settings} title={`Book a car and driver in ${city.name}`} text="We confirm the car, the rate and the pick-up point before your booking is final." message={`${waCity} Date: …, destination: …`} waRef={`${code}-band`} />
  ) : (
    <CtaBand settings={settings} title={`Pesan mobil di ${city.name} sekarang`} text="Admin kami mengonfirmasi unit, tarif, dan titik jemput sebelum pemesanan dipastikan." message={`${waCity} Tanggal: …, tujuan: …`} waRef={`${code}-band`} />
  )}
</Base>

<style>
  .rate-tables { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .rate-block { display: grid; gap: 12px; min-width: 0; }
  .rate-block h3 { font-size: 1.2rem; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); }
  .rates { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .rates th, .rates td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  .rates thead th { background: var(--paper); font: 700 0.75rem/1.2 var(--text); letter-spacing: 0.05em; text-transform: uppercase; color: var(--soft); }
  .rates thead th + th, .rates td { text-align: right; white-space: nowrap; }
  .rates td.ask { text-align: center; color: var(--soft); }
  .rates tbody th a { color: var(--deep); font-weight: 700; text-decoration: none; }
  .rates tbody th a:hover { color: var(--blue); }
  .rates tbody th small { display: block; font-size: 0.8rem; font-weight: 400; color: var(--soft); }
  .rates tbody tr:last-child > * { border-bottom: 0; }
  .rates td:nth-of-type(1):not(.ask) { color: var(--blue); font-weight: 700; }
  .shared-notes { margin-top: 16px; }
  .editorial { display: grid; grid-template-columns: 1fr 1.3fr; gap: 40px; }
  .dest { background: #fff; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); }
  .dest img { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .dest .stack { padding: 16px; gap: 6px; }
  .dest p { color: var(--soft); font-size: 0.95rem; }
  .dest small { font-size: 0.75rem; color: var(--soft); }
  .dest small a { color: var(--soft); }
  .area { display: inline-flex; align-items: center; gap: 4px; font-size: 0.8rem; font-weight: 700; color: var(--blue); }
  .route { display: grid; grid-template-columns: 28px 1fr; gap: 12px; padding: 18px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--blue); }
  .route h3 { color: var(--deep); }
  .dur { font: 800 1.1rem/1.4 var(--display); color: var(--blue); }
  .route .muted { font-size: 0.9rem; }
  .uclass { border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; display: grid; gap: 10px; align-content: start; }
  .uclass dl { display: grid; gap: 6px; margin: 0; }
  .uclass dl div { display: flex; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--line); padding-bottom: 6px; font-size: 0.92rem; }
  .uclass dt { color: var(--soft); }
  .uclass dd { margin: 0; font-weight: 600; color: var(--deep); text-align: right; }
  .uclass .btn { margin-top: 4px; }
  .transfers { margin-top: 18px; color: var(--body); }
  .transfers a { font-weight: 600; }
  .post { display: grid; gap: 8px; align-content: start; padding: 22px; background: #fff; border-radius: var(--radius); text-decoration: none; color: var(--ink); border: 1px solid var(--line); }
  .post:hover { border-color: var(--blue); color: var(--ink); }
  @media (max-width: 860px) { .editorial { grid-template-columns: 1fr; gap: 20px; } .rate-tables { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .rates { font-size: 0.88rem; } .rates th, .rates td { padding: 10px; } }
</style>
