---
/** Hub of all city pages: the crawl path from the home page to every city. */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaBand from '../components/CtaBand.astro';
import { getContent } from '../lib/content';
import { rupiah } from '../lib/format';
import { listJoin, ui, type Lang } from '../lib/i18n';
import { carImage, photo } from '../lib/images';
import { paths } from '../lib/paths';
import { cityIsIndexable } from '../lib/quality';
import { breadcrumbs } from '../lib/schema';

interface Props { lang: Lang }
const { lang } = Astro.props;
const en = lang === 'en';
const t = ui(lang);
const { settings, cities, cars } = await getContent(lang);
const site = (Astro.site?.toString() || settings.siteUrl).replace(/\/$/, '');
const path = paths.cities(lang);
const crumbs = [{ name: t.home, path: paths.home(lang) }, { name: en ? 'Cities' : 'Kota layanan', path }];
const live = cities.filter(cityIsIndexable);
const min = Math.min(...cars.map((c) => c.priceCity || Infinity));
const list = listJoin(live.map((c) => c.name), lang);
const groups = [
  { title: en ? 'Indonesia' : 'Domestik', items: live.filter((c) => c.country !== 'INTL') },
  { title: en ? 'Abroad' : 'Internasional', items: live.filter((c) => c.country === 'INTL') },
].filter((g) => g.items.length);
---
<Base title={en ? 'Car Rental with Driver: Cities We Serve | Arasya Rent Car' : 'Kota Layanan Sewa Mobil dengan Driver — Arasya Rent Car'} description={en ? `Car rental with a driver in ${list}. Twelve hours from ${rupiah(min)}, book on WhatsApp.` : `Sewa mobil dengan driver di ${list}. Tarif 12 jam mulai ${rupiah(min)}, pesan lewat WhatsApp.`} path={path} alternates={{ id: '/sewa-mobil', en: '/en/cities' }} jsonld={[{ '@type': 'ItemList', name: en ? 'Arasya service cities' : 'Kota layanan Arasya', itemListElement: live.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: t.rentIn(c.name), url: site + paths.city(c, lang) })) }, breadcrumbs(site, crumbs)]} waRef={en ? 'EN-HUB-fab' : 'HUB-fab'}>
  <section class="head">
    <div class="wrap stack">
      <Breadcrumbs items={crumbs} />
      <h1>{en ? 'Where we operate' : 'Kota layanan Arasya'}</h1>
      <p class="lead">{en
        ? `Arasya Rent Car provides cars with drivers in the cities below, and drives between cities and across provinces to wherever you need to go. Twelve hours in town starts at ${rupiah(min)}.`
        : `Arasya Rent Car melayani sewa mobil dengan driver di kota-kota berikut, dan perjalanan antar kota maupun antarprovinsi ke mana pun tujuan Anda. Tarif dalam kota 12 jam mulai ${rupiah(min)}.`}</p>
    </div>
  </section>
  <section class="section" style="padding-top:28px">
    <div class="wrap stack">
      {groups.map((g) => (
      <>
      {groups.length > 1 && <h2 class="gtitle">{g.title}</h2>}
      <div class="grid grid-3">
        {g.items.map((c) => {
          const dest = c.destinations?.find((d) => d.image?.asset || d.imagePath);
          const img = dest ? photo(dest.image, dest.imagePath, 800) : null;
          const car = img ? null : carImage(c.hero.car);
          return (
            <a class="city" href={paths.city(c, lang)}>
              {img && <img class="photo" src={img.src} srcset={img.srcset} sizes="(max-width: 560px) 92vw, 380px" alt="" loading="lazy" width="800" height="450" />}
              {car && <span class="car"><img src={car.src} srcset={car.srcset} sizes="380px" alt="" loading="lazy" width="960" height="600" /></span>}
              <div class="stack">
                <h2>{t.rentIn(c.name)}</h2>
                <p class="muted">{c.areaServed?.join(' · ')}</p>
                <span class="go">{c.pricing === 'quote' ? (en ? 'Ask for a quote →' : 'Lihat layanan →') : en ? `${c.name} rates →` : `Lihat tarif ${c.name} →`}</span>
              </div>
            </a>
          );
        })}
      </div>
      </>
      ))}
    </div>
  </section>
  {en ? (
    <CtaBand settings={settings} title="Travelling somewhere else?" text="Tell us the city and dates, and we'll check whether we have a car and driver there." message="Hi Arasya, I need a car with a driver in … on …" waRef="EN-HUB-band" />
  ) : (
    <CtaBand settings={settings} title="Kota Anda belum ada?" text="Kirim kota dan tanggal perjalanan, admin kami cek ketersediaan unit dan driver." message="Halo Arasya, saya mau sewa mobil di kota …, tanggal …" waRef="HUB-band" />
  )}
</Base>
<style>
  .head { background: var(--paper); padding-block: 24px 28px; border-bottom: 1px solid var(--line); }
  .cities { margin-top: 12px; }
  .city { display: grid; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); text-decoration: none; color: var(--ink); align-content: start; }
  .city:hover { border-color: var(--blue); color: var(--ink); }
  .photo { aspect-ratio: 16 / 9; object-fit: cover; width: 100%; }
  .car { aspect-ratio: 16 / 9; background: var(--sky); display: flex; align-items: flex-end; justify-content: center; padding: 16px 24px 8px; }
  .car img { width: 100%; height: 100%; object-fit: contain; object-position: bottom; }
  .city .stack { padding: 18px; gap: 6px; }
  .city h2 { font-size: 1.25rem; }
  .gtitle { font-size: 1.3rem; margin-top: 12px; }
  .go { font: 700 0.9rem/1.3 var(--display); color: var(--blue); }
</style>
