---
/**
 * One page per unit (/armada/{slug}, /en/fleet/{slug}). Built for searches
 * like "sewa innova reborn bogor": what the car is good for, its rates in
 * every table of the price list (car + driver and all-in areas), which cities
 * it serves, and the travel routes its price class covers.
 * Pages without their own copy (see carIsIndexable) ship as noindex.
 */
import Base from '../layouts/Base.astro';
import { withPolicy } from '../lib/faq';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CarImage from '../components/CarImage.astro';
import CarCard from '../components/CarCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import RateNotes from '../components/RateNotes.astro';
import { getContent, type Car } from '../lib/content';
import { rupiah } from '../lib/format';
import { brochure, carImage } from '../lib/images';
import { ui, type Lang } from '../lib/i18n';
import { paths, type Alternates } from '../lib/paths';
import { carIsIndexable, cityIsIndexable } from '../lib/quality';
import { breadcrumbs, carProduct, faqPage } from '../lib/schema';
import { refSlug, waHref } from '../lib/wa';
import { allInZones, driverZones, fromPrices, rate, siteZones, zoneArea, zoneLabel } from '../lib/prices';

interface Props { car: Car; lang: Lang; alternates: Alternates }
const { car, lang, alternates } = Astro.props;
const en = lang === 'en';
const t = ui(lang);
const { settings, cars, cities, services, prices } = await getContent(lang);
const site = (Astro.site?.toString() || settings.siteUrl).replace(/\/$/, '');
const path = paths.car(car.slug.current, lang);
const crumbs = [{ name: t.home, path: paths.home(lang) }, { name: en ? 'Fleet' : 'Armada', path: paths.fleet(lang) }, { name: car.name, path }];
const ref = `${en ? 'EN-' : ''}CAR-${refSlug(car.name)}`;
const wa = waHref(settings.waPhone, t.waRent(car.name), ref);
// Indonesian cities only: abroad we supply cars by class, not this exact model.
const liveCities = cities.filter((c) => cityIsIndexable(c) && c.country !== 'INTL');

// Travel routes this car's price class covers, with the price for that class.
const travel = services.find((s) => s.template === 'travel');
const unit = travel?.units?.find((u) => u.key === car.travelUnit);
const originName = (k: string) => travel?.origins?.find((o) => o.key === k)?.name || k;
const routes = unit && travel
  ? (travel.routes || []).flatMap((r) => {
      const p = r.prices.find((x) => x.unit === unit.key);
      return p ? [{ r, price: p.price }] : [];
    })
  : [];

const similar = cars.filter((c) => c._id !== car._id && c.category === car.category).slice(0, 3);
const others = similar.length >= 2 ? similar : cars.filter((c) => c._id !== car._id && Math.abs((c.capacity || 0) - (car.capacity || 0)) <= 1).slice(0, 3);
const img = carImage(car);
const card = brochure(car.slug.current);

// Rates from the published price list: "mulai" prices per 12 hours, and one row per table.
const from = fromPrices(prices, [car.slug.current]);
const priced = !!(from.driver || from.allIn);
const driverArea = from.driver ? zoneArea(from.driver.zone, lang) : '';
const allInArea = from.allIn ? zoneArea(from.allIn.zone, lang) : '';
const rows = siteZones(prices).map((zone) => ({ zone, h12: rate(prices, car.slug.current, zone, '12H'), full: rate(prices, car.slug.current, zone, 'FULLDAY') }));

const title = car.seo?.title || (en ? `${car.name} with Driver: Rates & Seats | Arasya Rent Car` : `Sewa ${car.name} dengan Driver — Tarif & Kapasitas | Arasya`);
const description = car.seo?.description || [
  en ? `Rent a ${car.name} with a professional driver` : `Sewa ${car.name} dengan driver`,
  t.passengers(car.capacity),
  from.driver ? t.fromDriver(rupiah(from.driver.amount), driverArea) : '',
  en ? 'Book on WhatsApp.' : 'Pesan via WhatsApp.',
].filter(Boolean).join('. ');

const priceAnswer = t.carAnswer({
  car: car.name,
  driver: from.driver ? { price: rupiah(from.driver.amount), area: driverArea } : undefined,
  allIn: from.allIn ? { price: rupiah(from.allIn.amount), area: allInArea } : undefined,
});
const priceQ = en ? `How much does it cost to rent a ${car.name} with a driver?` : `Berapa tarif sewa ${car.name} dengan driver?`;
const faq = [{ question: priceQ, answer: priceAnswer }, ...(car.faq || []).filter((f) => f.question !== priceQ)];
const faqAll = withPolicy(faq, settings, lang);
---
<Base title={title} description={description} path={path} alternates={alternates} noindex={!carIsIndexable(car)} ogImage={card?.jpg || (img?.src.startsWith('/') ? img.src : undefined)} waRef={`${ref}-fab`} waMessage={t.waRent(car.name)}
  jsonld={[carProduct(car, prices, site, lang, img ? (img.src.startsWith('/') ? site + img.src : img.src) : undefined), faqPage(faqAll), breadcrumbs(site, crumbs)]}>
  <section class="c-hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <div class="grid-hero">
        <div class="copy">
          <span class="pill">{t.category[car.category]}{car.badge ? ` · ${car.badge}` : ''}</span>
          <h1>{en ? <>{car.name} <span class="accent">with driver</span></> : <>Sewa {car.name} <span class="accent">dengan driver</span></>}</h1>
          {(car.summary || car.description) && <p class="lead">{car.summary || car.description}</p>}
          <dl class="specs">
            <div><dt>{en ? 'Seats' : 'Kursi'}</dt><dd class="num">{car.capacity ?? '–'}</dd></div>
            <div><dt>{en ? 'Passengers' : 'Penumpang'}</dt><dd class="num">{car.capacity ? car.capacity - 1 : '–'}</dd></div>
            {car.luggage && <div class="wide"><dt>{en ? 'Luggage' : 'Bagasi'}</dt><dd>{car.luggage}</dd></div>}
          </dl>
        </div>
        <div class="stage"><CarImage car={car} eager sizes="(max-width: 860px) 92vw, 560px" /></div>
      </div>
      <div class="price-bar" data-fab-tuck>
        <div class="prices">
          {priced ? (
            <>
              {from.driver && <div><span class="lbl">{t.fromLbl(t.pkgDriver, driverArea)}</span><b class="num">{rupiah(from.driver.amount)}<small>{t.per12}</small></b></div>}
              {from.allIn && <div><span class="lbl">{t.fromLbl(t.allIn, allInArea)}</span><b class="num">{rupiah(from.allIn.amount)}<small>{t.per12}</small></b></div>}
            </>
          ) : (
            <div><span class="lbl">{t.rate}</span><b>{t.quotedPerTrip}</b></div>
          )}
        </div>
        <a class="btn btn-wa" href={wa} data-cta="car-hero" rel="nofollow"><Icon name="wa" />{en ? `Book the ${car.name}` : `Pesan ${car.name}`}</a>
      </div>
    </div>
  </section>

  {(car.idealFor?.length || car.features?.length) && (
    <section class="section">
      <div class="wrap fit">
        {car.idealFor && car.idealFor.length > 0 && (
          <div class="stack">
            <span class="eyebrow">{en ? 'Good for' : 'Cocok untuk'}</span>
            <h2>{en ? `When to choose the ${car.name}` : `Kapan memilih ${car.name}`}</h2>
            <ul class="ticks">{car.idealFor.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul>
          </div>
        )}
        {car.features && car.features.length > 0 && (
          <div class="feats">
            {car.features.map((f) => <div class="feat"><h3>{f.title}</h3>{f.text && <p>{f.text}</p>}</div>)}
          </div>
        )}
      </div>
    </section>
  )}

  <section class="section tint">
    <div class:list={['wrap', { 'with-card': !!card }]}>
      <div>
      <div class="section-head"><div class="stack"><span class="eyebrow">{t.rate}</span><h2>{t.carRatesTitle(car.name)}</h2><p class="intro">{priceAnswer}</p></div></div>
      {priced && (
        <div class="rate-info">
          <div class="table-wrap">
            <table class="car-rates">
              <caption class="sr-only">{t.carTableCaption(car.name)}</caption>
              <thead><tr><th scope="col">{t.colPackage}</th><th scope="col">{t.col12h}</th><th scope="col">{t.colFullday}</th></tr></thead>
              <tbody>
                {rows.map(({ zone, h12, full }) => (
                  <tr>
                    <th scope="row">{zoneLabel(zone, lang)}</th>
                    {h12 == null && full == null
                      ? <td class="ask" colspan="2">{t.askAdmin}</td>
                      : <><td class="num">{h12 ? rupiah(h12) : t.askAdmin}</td><td class="num">{full ? rupiah(full) : t.askAdmin}</td></>}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <RateNotes prices={prices} lang={lang} zone={driverZones(prices)[0]} title={t.pkgDriverTitle} />
          <RateNotes prices={prices} lang={lang} zone={allInZones(prices)[0]} title={t.pkgAllInTitle} />
          <RateNotes prices={prices} lang={lang} shared />
        </div>
      )}
      {liveCities.length > 0 && (
        <div class="cities">
          <h3>{en ? 'Available in, among others' : 'Tersedia di, antara lain'}</h3>
          <ul>{liveCities.map((c) => <li><a href={paths.city(c, lang)}><Icon name="pin" size={16} />{c.name}</a></li>)}</ul>
          <p class="muted">{en ? 'And for trips from these cities to anywhere you need to go.' : 'Juga untuk perjalanan dari kota-kota tersebut ke mana pun tujuan Anda.'}</p>
        </div>
      )}
    </div>
      {card && (
        <figure class="card">
          <a href={card.jpg} target="_blank" rel="noopener"><img src={card.webp} alt={en ? `${car.name} with driver, Arasya Rent Car` : `Brosur sewa ${car.name} dengan driver, Arasya Rent Car`} width="1280" height="860" loading="lazy" decoding="async" /></a>
          <figcaption>{en ? 'Unit brochure: tap to open, save or forward it.' : 'Brosur unit: ketuk untuk membuka, menyimpan, atau meneruskannya.'} <a href={card.jpg} download={`Arasya-${car.slug.current}.jpg`} data-dl={car.slug.current}>{en ? 'Download' : 'Unduh'}</a></figcaption>
        </figure>
      )}
    </div>
  </section>

  {routes.length > 0 && travel && unit && (
    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div class="stack"><span class="eyebrow">{en ? 'Private transfer' : 'Travel carter'}</span><h2>{en ? `Intercity trips in this class` : `Rute antar kota untuk kelas ini`}</h2><p class="muted">{en ? `One-way price per car for the ${unit.name} class, driver included.` : `Tarif sekali jalan per mobil kelas ${unit.name}, sudah termasuk driver.`}</p></div>
          <a class="link-more" href={paths.service(travel, lang)}>{en ? 'All transfer rates →' : 'Semua tarif travel →'}</a>
        </div>
        <div class="grid grid-2">
          {routes.map(({ r, price }) => {
            const linked = !!r.intro;
            const label = `${originName(r.origin)} → ${r.destName}`;
            return (
              <div class="route">
                <Icon name="route" size={20} />
                <div>{linked ? <a href={paths.route(travel, r, lang)}>{label}</a> : <b>{label}</b>}{r.duration && <small>{r.duration}</small>}</div>
                <span class="num">{rupiah(price)}</span>
              </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <Faq items={faqAll} title={en ? `${car.name} questions` : `Tanya jawab sewa ${car.name}`} />

  {others.length > 0 && (
    <section class="section tint">
      <div class="wrap">
        <div class="section-head"><div class="stack"><span class="eyebrow">{en ? 'Compare' : 'Bandingkan'}</span><h2>{en ? 'Similar cars' : 'Unit serupa'}</h2></div><a class="link-more" href={paths.fleet(lang)}>{en ? 'Full fleet →' : 'Semua armada →'}</a></div>
        <div class="grid grid-3">{others.map((c) => <CarCard car={c} settings={settings} refPrefix={`${ref}-alt`} tone="white" />)}</div>
      </div>
    </section>
  )}

  {en ? (
    <CtaBand settings={settings} title={`Book the ${car.name}`} text="Send your date, pick-up point and destination. We confirm the car, the driver and the rate before you pay anything." message={t.waRent(car.name)} waRef={`${ref}-band`} />
  ) : (
    <CtaBand settings={settings} title={`Pesan ${car.name} sekarang`} text="Kirim tanggal, titik jemput, dan tujuan. Admin kami mengonfirmasi unit, driver, dan tarif sebelum Anda membayar." message={t.waRent(car.name)} waRef={`${ref}-band`} />
  )}
</Base>

<style>
  .c-hero { background: linear-gradient(180deg, var(--sky) 0%, #f2f8fe 100%); padding-block: 24px 40px; border-bottom: 1px solid #dbe8f6; }
  .grid-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 32px; align-items: center; margin-top: 20px; }
  .copy { display: grid; gap: 16px; }
  .pill { justify-self: start; }
  .accent { color: var(--blue); }
  .specs { display: flex; flex-wrap: wrap; gap: 10px; margin: 0; }
  .specs div { background: #fff; border: 1px solid #dbe8f6; border-radius: 10px; padding: 10px 14px; min-width: 96px; }
  .specs .wide { flex: 1 1 220px; }
  dt { font: 700 0.7rem/1.2 var(--text); letter-spacing: 0.05em; text-transform: uppercase; color: var(--soft); }
  dd { margin: 4px 0 0; font: 700 1.05rem/1.3 var(--display); color: var(--deep); }
  .specs .wide dd { font: 500 0.92rem/1.4 var(--text); color: var(--body); }
  .stage { display: flex; justify-content: center; }
  .stage :global(img) { width: 100%; max-width: 560px; max-height: 320px; object-fit: contain; filter: drop-shadow(0 18px 14px rgba(2, 38, 75, 0.18)); }
  .price-bar { margin-top: 28px; background: #fff; border: 1px solid #e3ebf4; border-radius: var(--radius); box-shadow: 0 8px 24px rgba(2, 38, 75, 0.1); padding: 16px 20px; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .prices { display: flex; gap: 28px; flex-wrap: wrap; }
  .prices div { display: grid; gap: 4px; }
  .lbl { font-size: 0.8rem; color: var(--soft); }
  .prices b { font: 800 1.4rem/1 var(--display); color: var(--deep); }
  .prices b small { font: 600 0.8rem/1 var(--text); color: var(--soft); margin-left: 3px; display: inline-block; white-space: nowrap; }
  .prices div:first-child b { color: var(--blue); }
  .fit { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 40px; align-items: start; }
  .ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .ticks li { display: grid; grid-template-columns: 22px 1fr; gap: 8px; color: var(--body); }
  .ticks :global(svg) { color: var(--blue); margin-top: 3px; }
  .feats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .feat { border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; display: grid; gap: 6px; align-content: start; }
  .feat p { color: var(--soft); font-size: 0.95rem; }
  .rate-info { display: grid; gap: 16px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
  .car-rates { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .car-rates th, .car-rates td { padding: 11px 14px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  .car-rates thead th { background: var(--paper); font: 700 0.75rem/1.2 var(--text); letter-spacing: 0.05em; text-transform: uppercase; color: var(--soft); }
  .car-rates thead th + th, .car-rates td { text-align: right; white-space: nowrap; }
  .car-rates td.ask { text-align: center; color: var(--soft); }
  .car-rates tbody th { font-weight: 700; color: var(--deep); }
  .car-rates tbody tr:last-child > * { border-bottom: 0; }
  .car-rates td:nth-of-type(1):not(.ask) { color: var(--blue); font-weight: 700; }
  @media (max-width: 480px) { .car-rates { font-size: 0.88rem; } .car-rates th, .car-rates td { padding: 10px; } }
  .with-card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 40px; align-items: start; }
  .card { margin: 0; display: grid; gap: 8px; }
  .card img { width: 100%; height: auto; border-radius: var(--radius); box-shadow: 0 10px 28px rgba(2, 38, 75, 0.12); }
  .card figcaption { font-size: 0.85rem; color: var(--soft); }
  .card figcaption a { font-weight: 700; }
  @media (max-width: 860px) { .with-card { grid-template-columns: 1fr; gap: 24px; } }
  .cities { margin-top: 24px; display: grid; gap: 10px; }
  .cities h3 { font-size: 1rem; }
  .cities ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .cities a { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: #fff; text-decoration: none; font-weight: 600; font-size: 0.92rem; color: var(--deep); }
  .cities a:hover { border-color: var(--blue); color: var(--blue); }
  .route { display: grid; grid-template-columns: 24px 1fr auto; gap: 12px; align-items: center; padding: 14px 16px; border: 1px solid var(--line); border-radius: var(--radius); color: var(--blue); }
  .route a, .route b { font: 700 1rem/1.3 var(--display); color: var(--deep); text-decoration: none; }
  .route a:hover { color: var(--blue); }
  .route small { display: block; color: var(--soft); font-size: 0.85rem; }
  .route .num { font: 800 1.05rem/1 var(--display); color: var(--blue); }
  @media (max-width: 860px) {
    .grid-hero, .fit { grid-template-columns: 1fr; gap: 20px; }
    .stage :global(img) { max-height: 220px; }
    .price-bar .btn { width: 100%; }
  }
  @media (max-width: 520px) { .feats { grid-template-columns: 1fr; } }
</style>
