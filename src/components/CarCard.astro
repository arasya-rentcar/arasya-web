---
import { getContent, type Car, type Settings } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
import { rupiah, rupiahShort } from '../lib/format';
import { paths } from '../lib/paths';
import { fromPrices, zoneArea } from '../lib/prices';
import { waHref, refSlug } from '../lib/wa';
import CarImage from './CarImage.astro';
import Icon from './Icon.astro';

/** `consult` hides prices and turns the button into a price consultation (wedding, corporate). */
interface Props { car: Car; settings: Settings; refPrefix: string; context?: string; tone?: 'sky' | 'white' | 'ivory'; consult?: boolean }
const { car, settings, refPrefix, context = '', tone = 'sky', consult = false } = Astro.props;
const lang = langOf(Astro.url.pathname);
const t = ui(lang);
const message = consult ? t.waConsult(car.name, context) : t.waRent(car.name, context);
const href = waHref(settings.waPhone, message, `${refPrefix}-${refSlug(car.name)}`);
const page = paths.car(car.slug.current, lang);
// "Mulai" prices from the published price list, with the area they apply to.
const { prices } = await getContent(lang);
const from = fromPrices(prices, [car.slug.current]);
const money = (n: number) => (lang === 'en' ? rupiah(n) : rupiahShort(n));
---
<article class={`car-card tone-${tone}`} id={car.slug.current}>
  <div class="ph">
    {car.badge && <span class="badge">{car.badge}</span>}
    <CarImage car={car} />
  </div>
  <div class="body">
    <h3><a href={page}>{car.name}</a></h3>
    <p class="meta"><Icon name="users" size={16} />{t.passengers(car.capacity)} · {t.category[car.category]}</p>
  </div>
  {consult ? (
    <p class="consult">{t.consultNote}</p>
  ) : (
  <div class="price">
    {from.driver ? (
      <div><span class="lbl">{t.fromLbl(t.pkgDriver, zoneArea(from.driver.zone, lang))}</span><strong class="num">{money(from.driver.amount)}<small>{t.per12}</small></strong></div>
    ) : (
      <div><span class="lbl">{t.rate}</span><strong>{t.askAdmin}</strong></div>
    )}
    {from.allIn && <div class="allin"><span class="lbl">{t.fromLbl(t.allIn, zoneArea(from.allIn.zone, lang))}</span><span class="num">{money(from.allIn.amount)}</span></div>}
  </div>
  )}
  <a class="btn btn-outline" href={href} data-cta={`car-${refSlug(car.name)}`} rel="nofollow"><Icon name="wa" />{consult ? t.consultPrice : t.bookThis}</a>
</article>

<style>
  .car-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 12px; display: grid; grid-template-rows: auto 1fr auto auto; gap: 12px; background: #fff; min-width: 0; }
  .ph { position: relative; background: var(--sky); border-radius: 10px; padding: 14px 10px 6px; aspect-ratio: 16 / 10; display: flex; align-items: flex-end; justify-content: center; }
  .tone-ivory .ph { background: #f3efe6; }
  .tone-white .ph { background: var(--paper); }
  .ph img { width: 100%; height: 100%; min-height: 0; object-fit: contain; object-position: bottom; }
  .ph { min-width: 0; overflow: hidden; }
  .badge { position: absolute; left: 10px; top: 10px; background: var(--deep); color: #fff; font: 700 0.72rem/1 var(--text); padding: 5px 8px; border-radius: 6px; }
  .body { display: grid; gap: 4px; padding-inline: 4px; align-content: start; }
  .body h3 a { color: inherit; text-decoration: none; }
  .body h3 a:hover { color: var(--blue); }
  .meta { display: flex; align-items: flex-start; gap: 6px; line-height: 1.4; font-size: 0.85rem; color: var(--soft); }
  .price { display: grid; gap: 8px; align-content: start; border-top: 1px solid var(--line); padding: 10px 4px 0; }
  .price > div { display: grid; gap: 2px; }
  .lbl { font-size: 0.75rem; color: var(--soft); }
  .price strong { font: 800 1.25rem/1 var(--display); color: var(--blue); }
  .price strong small { font: 600 0.75rem/1 var(--text); color: var(--soft); margin-left: 3px; display: inline-block; white-space: nowrap; }
  .price > .allin { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 6px; font-size: 0.85rem; color: var(--deep); font-weight: 600; }
  .allin .lbl { font-weight: 400; }
  .btn { width: 100%; }
  .consult { border-top: 1px solid var(--line); padding: 10px 4px 0; font-size: 0.88rem; color: var(--soft); }
</style>
