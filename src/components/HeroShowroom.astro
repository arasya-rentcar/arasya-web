---
import type { Car, Hero, Settings } from '../lib/content';
import { rupiah } from '../lib/format';
import BookingBar from './BookingBar.astro';
import CarImage from './CarImage.astro';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props { hero: Hero; settings: Settings; cars: Car[]; refCode: string; fromPrice?: number; crumbs?: { name: string; path: string }[]; pickup?: string }
const { hero, settings, cars, refCode, fromPrice, crumbs, pickup } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="grid-hero">
      <div class="copy">
        {hero.eyebrow && <span class="pill">{hero.eyebrow}</span>}
        <h1>{hero.title}{hero.titleAccent && <> <span class="accent">{hero.titleAccent}</span></>}</h1>
        {hero.lead && <p class="lead">{hero.lead}</p>}
      </div>
      <div class="car">
        <CarImage car={hero.car} eager sizes="(max-width: 860px) 92vw, 620px" />
        {fromPrice && (
          <div class="from"><span>Mulai dari</span><b class="num">{rupiah(fromPrice)}</b><span>12 jam dalam kota, sudah dengan driver</span></div>
        )}
      </div>
    </div>
  </div>
  <div class="wrap booking-wrap">
    <BookingBar settings={settings} cars={cars} refCode={refCode} defaultPickup={pickup} />
  </div>
</section>

<style>
  .hero { background: linear-gradient(180deg, var(--sky) 0%, var(--sky) 72%, #fff 72%); padding-top: 24px; }
  .grid-hero { display: grid; grid-template-columns: 1fr 1.1fr; gap: 16px; align-items: end; margin-top: 16px; }
  .copy { display: grid; gap: 16px; padding-bottom: 48px; }
  .accent { color: var(--blue); }
  .lead { color: #364152; }
  .car { position: relative; }
  .car :global(img) { width: 100%; max-width: 600px; margin-left: auto; filter: drop-shadow(0 22px 16px rgba(2, 38, 75, 0.22)); }
  .from { position: absolute; right: 4%; top: 2%; background: var(--deep); color: #dde3ea; padding: 12px 16px; border-radius: 12px; display: grid; gap: 2px; font-size: 0.78rem; line-height: 1.3; max-width: 190px; }
  .from b { font: 800 1.5rem/1.1 var(--display); color: #fff; }
  .booking-wrap { position: relative; margin-top: -8px; }
  @media (max-width: 860px) {
    .hero { background: var(--sky); padding-bottom: 24px; }
    .grid-hero { grid-template-columns: 1fr; }
    .copy { padding-bottom: 0; }
    .from { position: static; margin: -8px 0 12px auto; max-width: none; grid-auto-flow: row; }
  }
</style>
