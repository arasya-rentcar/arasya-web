---
import type { Car, Hero, Settings } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
import { rupiah } from '../lib/format';
import BookingBar from './BookingBar.astro';
import CarImage from './CarImage.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';

/** `fromPrice` is a "mulai" price per 12 hours; `fromNote` says which package and area it is for. */
interface Props { hero: Hero; settings: Settings; cars: Car[]; refCode: string; fromPrice?: number; fromNote?: string; crumbs?: { name: string; path: string }[]; pickup?: string }
const { hero, settings, cars, refCode, fromPrice, fromNote, crumbs, pickup } = Astro.props;
const t = ui(langOf(Astro.url.pathname));
const checks = t.heroChecks(settings.legalName);
---
<section class="hero">
  <div class="wrap">
    {crumbs && <Breadcrumbs items={crumbs} />}
    <div class="grid-hero">
      <div class="copy">
        {hero.eyebrow && <span class="pill">{hero.eyebrow}</span>}
        <h1>{hero.title}{hero.titleAccent && <> <span class="accent">{hero.titleAccent}</span></>}</h1>
        {hero.lead && <p class="lead">{hero.lead}</p>}
        {fromPrice && (
          <p class="from">{t.from} <b class="num">{rupiah(fromPrice)}</b> <span>{fromNote || t.per12}</span></p>
        )}
        <ul class="checks">
          {checks.map((c) => <li><Icon name="check" size={16} />{c}</li>)}
        </ul>
      </div>
      <div class="car">
        <CarImage car={hero.car} eager sizes="(max-width: 860px) 88vw, 560px" />
      </div>
    </div>
    <div class="booking-wrap">
      <BookingBar settings={settings} cars={cars} refCode={refCode} defaultPickup={pickup} />
    </div>
  </div>
</section>

<style>
  .hero { background: linear-gradient(180deg, var(--sky) 0%, #f2f8fe 100%); padding-block: 24px 48px; border-bottom: 1px solid #dbe8f6; }
  .grid-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 32px; align-items: center; margin-top: 20px; }
  .copy { display: grid; gap: 16px; align-content: center; }
  .accent { color: var(--blue); }
  .from { font-size: 1rem; color: var(--body); }
  .from b { font: 800 1.35rem/1 var(--display); color: var(--deep); }
  .from span { color: var(--soft); }
  .checks { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 18px; font-size: 0.9rem; color: var(--body); }
  .checks li { display: inline-flex; align-items: center; gap: 6px; }
  .checks :global(svg) { color: var(--blue); flex: none; }
  .car { display: flex; align-items: flex-end; justify-content: center; }
  .car :global(img) { width: 100%; max-width: 560px; max-height: 340px; object-fit: contain; filter: drop-shadow(0 18px 14px rgba(2, 38, 75, 0.18)); }
  .booking-wrap { margin-top: 36px; }
  @media (max-width: 860px) {
    .hero { padding-bottom: 32px; }
    .grid-hero { grid-template-columns: 1fr; gap: 20px; }
    .car :global(img) { max-height: 220px; }
    .booking-wrap { margin-top: 24px; }
  }
</style>
