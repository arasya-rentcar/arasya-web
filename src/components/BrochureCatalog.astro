---
/**
 * Swipeable catalogue of the branded unit cards, plus one PDF with all of
 * them, for visitors who want to compare units or forward the lot to family
 * or their office. Rebuild the PDF with scripts/build-catalog.py.
 */
import { existsSync, statSync } from 'node:fs';
import { join } from 'node:path';
import type { Car } from '../lib/content';
import type { Lang } from '../lib/i18n';
import { brochure } from '../lib/images';
import { paths } from '../lib/paths';
import Icon from './Icon.astro';

interface Props { cars: Car[]; lang: Lang }
const { cars, lang } = Astro.props;
const en = lang === 'en';
const items = cars.map((c) => ({ car: c, card: brochure(c.slug.current) })).filter((i) => i.card);
const pdf = '/katalog-arasya-rentcar.pdf';
const pdfFile = join(process.cwd(), 'public', pdf);
const pdfSize = existsSync(pdfFile) ? (statSync(pdfFile).size / 1048576).toLocaleString(en ? 'en' : 'id', { maximumFractionDigits: 1 }) + ' MB' : '';
---
{items.length > 0 && (
  <section class="catalog" id={en ? 'catalogue' : 'katalog'} aria-labelledby="catalog-h">
    <div class="top">
      <div>
        <h2 id="catalog-h">{en ? 'Unit catalogue' : 'Katalog unit'}</h2>
        <p class="muted">{en ? 'Every unit as a brochure you can save or forward. Swipe to browse, or download them all in one PDF.' : 'Semua unit dalam bentuk brosur yang bisa disimpan atau diteruskan. Geser untuk melihat, atau unduh semuanya dalam satu PDF.'}</p>
      </div>
      {pdfSize && (
        <a class="btn btn-blue dl" href={pdf} download="Katalog-Arasya-Rent-Car.pdf" data-dl="catalog_pdf">
          <Icon name="download" />{en ? 'Download catalogue' : 'Unduh katalog'} <small>PDF · {pdfSize}</small>
        </a>
      )}
    </div>
    <div class="rail">
      <button class="nav prev" type="button" aria-label={en ? 'Previous' : 'Sebelumnya'} data-dir="-1" hidden>‹</button>
      <ul class="track" tabindex="0" aria-label={en ? 'Unit brochures' : 'Brosur unit'}>
        {items.map(({ car, card }) => (
          <li>
            <a class="img" href={card!.jpg} target="_blank" rel="noopener">
              <img src={card!.webp} alt={en ? `${car.name} with driver, Arasya Rent Car brochure` : `Brosur sewa ${car.name} dengan driver, Arasya Rent Car`} width="1280" height="860" loading="lazy" decoding="async" />
            </a>
            <div class="cap">
              <a href={paths.car(car.slug.current, lang)}>{car.name}</a>
              <a class="save" href={card!.jpg} download={`Arasya-${car.slug.current}.jpg`} data-dl={car.slug.current}><Icon name="download" size={16} />{en ? 'Save' : 'Simpan'}</a>
            </div>
          </li>
        ))}
      </ul>
      <button class="nav next" type="button" aria-label={en ? 'Next' : 'Berikutnya'} data-dir="1" hidden>›</button>
    </div>
  </section>
)}

<script>
  document.querySelectorAll<HTMLElement>('.catalog .rail').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('.track')!;
    const [prev, next] = rail.querySelectorAll<HTMLButtonElement>('.nav');
    const sync = () => {
      prev.hidden = track.scrollLeft < 8;
      next.hidden = track.scrollLeft + track.clientWidth > track.scrollWidth - 8;
    };
    rail.querySelectorAll<HTMLButtonElement>('.nav').forEach((b) =>
      b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * track.clientWidth * 0.9, behavior: 'smooth' })),
    );
    track.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  });
</script>

<style>
  .catalog { display: grid; min-width: 0; gap: 16px; margin-top: 40px; scroll-margin-top: 88px; }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 16px 24px; flex-wrap: wrap; }
  .top h2 { font-size: 1.4rem; }
  .top p { margin-top: 4px; max-width: 60ch; }
  .dl small { font-weight: 500; opacity: 0.8; font-size: 0.78rem; }
  .rail { position: relative; min-width: 0; }
  .track { list-style: none; margin: 0; padding: 4px 2px 14px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(280px, calc((100% - 32px) / 3)); gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 2px; overscroll-behavior-x: contain; scrollbar-width: thin; }
  .track:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
  .track li { scroll-snap-align: start; display: grid; gap: 8px; }
  .img { display: block; border-radius: var(--radius); overflow: hidden; box-shadow: 0 6px 18px rgba(2, 38, 75, 0.1); transition: transform 0.2s, box-shadow 0.2s; }
  .img:hover { transform: translateY(-2px); box-shadow: 0 10px 26px rgba(2, 38, 75, 0.16); }
  .img img { display: block; width: 100%; height: auto; aspect-ratio: 1280 / 860; }
  .cap { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding-inline: 2px; }
  .cap a { font: 700 0.92rem/1.3 var(--display); color: var(--ink); text-decoration: none; }
  .cap a:hover { color: var(--blue); }
  .cap .save { display: inline-flex; align-items: center; gap: 4px; color: var(--blue); font-size: 0.85rem; white-space: nowrap; }
  .nav { position: absolute; top: calc(50% - 30px); transform: translateY(-50%); z-index: 1; width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--ink); font: 400 1.6rem/1 var(--text); cursor: pointer; box-shadow: 0 4px 14px rgba(2, 38, 75, 0.15); display: grid; place-items: center; padding-bottom: 3px; }
  .nav[hidden] { display: none; }
  .nav:hover { background: var(--ink); color: #fff; }
  .prev { left: -14px; }
  .next { right: -14px; }
  @media (max-width: 900px) { .track { grid-auto-columns: minmax(260px, 46%); } }
  @media (max-width: 600px) {
    .track { grid-auto-columns: 84%; }
    .nav { display: none; }
    .dl { width: 100%; justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) { .img { transition: none; } .img:hover { transform: none; } }
</style>
