---
import type { Content } from '../lib/content';
import { ui } from '../lib/i18n';
import { paths, type Alternates } from '../lib/paths';
import { cityIsIndexable } from '../lib/quality';
import { waHref } from '../lib/wa';
import Icon from './Icon.astro';

interface Props { content: Content; path: string; alternates: Alternates }
const { content, path, alternates } = Astro.props;
const { settings, services, cities, posts, lang } = content;
const t = ui(lang);

// Only cities that are live in search appear in the menu; thin drafts stay reachable by URL.
const menuCities = cities.filter(cityIsIndexable).map((c) => ({ href: paths.city(c, lang), label: c.name }));
const allCities = paths.cities(lang);
const inCities = path === allCities || menuCities.some((c) => c.href === path);
const links = [
  { href: paths.fleet(lang), label: t.navFleet },
  ...services.map((s) => ({ href: paths.service(s, lang), label: s.navLabel || s.slug.current })),
  ...(posts.length ? [{ href: paths.blog(), label: t.navBlog }] : []),
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const wa = waHref(settings.waPhone, t.waHello, 'NAV');
// Switcher: the same page in the other language, or that language's home page.
const otherLang = lang === 'id' ? 'en' : 'id';
const switchHref = alternates[otherLang] || paths.home(otherLang);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={paths.home(lang)} aria-label={t.toHome(settings.brandName)}>
      <img src="/brand/logo-dark.png" alt={settings.brandName} width="140" height="54" />
    </a>
    <nav class="nav" aria-label={t.navMain}>
      <ul>
        {menuCities.length > 0 && (
          <li>
            <details class="dd" data-dd>
              <summary class:list={['dd-toggle', { active: inCities }]}>
                {t.navCities} <svg class="chev" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </summary>
              <div class="dd-menu">
                <ul class:list={['dd-list', { cols: menuCities.length > 8 }]}>
                  {menuCities.map((c) => (
                    <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}><Icon name="pin" size={16} />{c.label}</a></li>
                  ))}
                </ul>
                <a class="dd-all" href={allCities} aria-current={path === allCities ? 'page' : undefined}>{t.navAllCities} →</a>
              </div>
            </details>
          </li>
        )}
        {links.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="phone num" href={`tel:+${settings.waPhone}`}><Icon name="phone" size={16} />{settings.phones[0]}</a>
      <a class="lang" href={switchHref} hreflang={otherLang} lang={otherLang} data-lang-switch={otherLang} aria-label={t.switchLabel}><span aria-hidden="true">{otherLang.toUpperCase()}</span></a>
      <a class="btn btn-wa" href={wa} data-cta="nav-wa" rel="nofollow"><Icon name="wa" />{t.navBook}</a>
      <details class="mnav" data-dd>
        <summary aria-label={t.navOpenMenu}><Icon name="menu" size={24} /></summary>
        <div class="mnav-panel">
          {menuCities.length > 0 && (
            <div class="mgroup">
              <span class:list={['mlabel', { active: inCities }]}>{t.navCities}</span>
              <ul class="mcities">
                {menuCities.map((c) => <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>)}
                <li><a href={allCities} aria-current={path === allCities ? 'page' : undefined}>{t.navAllCitiesShort}</a></li>
              </ul>
            </div>
          )}
          <ul>
            {links.map((n) => <li><a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
            <li><a href={`tel:+${settings.waPhone}`} class="num">{t.call} {settings.phones[0]}</a></li>
            <li><a href={switchHref} hreflang={otherLang} lang={otherLang} data-lang-switch={otherLang}>{otherLang === 'en' ? 'English' : 'Bahasa Indonesia'}</a></li>
          </ul>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close open menus on outside click or Escape; keep only one open at a time.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('details[data-dd]')];
  document.addEventListener('click', (ev) => {
    menus.forEach((d) => { if (d.open && !d.contains(ev.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    menus.forEach((d) => { if (d.open) { d.open = false; d.querySelector('summary')?.focus(); } });
  });
  menus.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) menus.forEach((o) => { if (o !== d) o.open = false; });
  }));
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.94); backdrop-filter: saturate(1.4) blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 24px; min-height: 68px; }
  .brand img { height: 38px; width: auto; }
  .nav { flex: 1; }
  .nav > ul { display: flex; align-items: center; gap: 22px; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .nav > ul > li > a, .dd-toggle { color: var(--ink); text-decoration: none; font-weight: 500; font-size: 0.95rem; padding-block: 6px; border-bottom: 2px solid transparent; }
  .nav > ul > li > a:hover, .nav > ul > li > a[aria-current='page'] { color: var(--blue); border-bottom-color: var(--blue); }

  .dd { position: relative; }
  .dd-toggle { list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; }
  .dd-toggle::-webkit-details-marker { display: none; }
  .dd-toggle:hover, .dd-toggle.active { color: var(--blue); }
  .dd-toggle.active { border-bottom-color: var(--blue); }
  .chev { transition: transform 0.15s; }
  .dd[open] .chev { transform: rotate(180deg); }
  .dd-menu { position: absolute; left: -12px; top: calc(100% + 12px); min-width: 240px; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 8px; display: grid; gap: 4px; }
  .dd-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: min(60vh, 420px); overflow-y: auto; }
  .dd-list.cols { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
  .dd-list a { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-radius: 8px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .dd-list a :global(svg) { color: var(--soft); flex: none; }
  .dd-list a:hover { background: var(--paper); color: var(--blue); }
  .dd-list a[aria-current='page'] { background: var(--sky); color: var(--blue); font-weight: 700; }
  .dd-list a[aria-current='page'] :global(svg) { color: var(--blue); }
  .dd-all { display: block; border-top: 1px solid var(--line); margin-top: 4px; padding: 10px 12px 6px; font: 700 0.9rem/1.2 var(--display); text-decoration: none; }

  .actions { display: flex; align-items: center; gap: 14px; margin-left: auto; }
  .phone { display: inline-flex; align-items: center; gap: 6px; color: var(--deep); text-decoration: none; font: 700 0.95rem/1 var(--display); }
  .actions .btn { padding: 11px 16px; }
  .lang { font: 700 0.8rem/1 var(--text); letter-spacing: 0.04em; color: var(--deep); text-decoration: none; border: 1px solid var(--line); border-radius: 8px; padding: 8px 9px; }
  .lang:hover { border-color: var(--blue); color: var(--blue); }
  .mnav { display: none; position: relative; }
  .mnav summary { list-style: none; cursor: pointer; padding: 8px; color: var(--deep); }
  .mnav summary::-webkit-details-marker { display: none; }
  .mnav-panel { position: absolute; right: 0; top: calc(100% + 10px); width: min(300px, 88vw); max-height: 75vh; overflow-y: auto; background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); padding: 8px; display: grid; gap: 6px; }
  .mnav-panel ul { list-style: none; margin: 0; padding: 0; }
  .mnav-panel a { display: block; padding: 12px; color: var(--ink); text-decoration: none; border-radius: 8px; font-weight: 600; }
  .mnav-panel a:hover, .mnav-panel a[aria-current='page'] { background: var(--sky); color: var(--blue); }
  .mgroup { border-bottom: 1px solid var(--line); padding-bottom: 6px; }
  .mlabel { display: block; padding: 8px 12px 4px; font: 700 0.72rem/1 var(--text); letter-spacing: 0.08em; text-transform: uppercase; color: var(--soft); }
  .mlabel.active { color: var(--blue); }
  .mcities a { font-weight: 500; padding-block: 10px; }
  @media (max-width: 1080px) { .phone { display: none; } }
  @media (max-width: 920px) { .nav { display: none; } .mnav { display: block; } }
  @media (max-width: 400px) { .lang { display: none; } }
</style>
