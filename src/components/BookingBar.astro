---
/**
 * Booking form. Collects what the admin would otherwise ask one by one
 * (name, date, time, pick-up, destination, car) and sends it as a single
 * structured WhatsApp message. When PUBLIC_LEADS_API is set, the request is
 * also recorded in the admin dashboard (fire-and-forget; WhatsApp never waits
 * on it). Without JS the form falls back to a plain wa.me link.
 *
 * With PUBLIC_GOOGLE_MAPS_KEY set, pick-up and destination also get place
 * suggestions and a map picker (src/lib/mapsPicker.ts, loaded on first use);
 * a chosen point adds a map link to the message and coordinates to the lead.
 * Without the key none of that markup or script exists.
 */
import type { HTMLAttributes } from 'astro/types';
import type { Car, Settings } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
import { waHref } from '../lib/wa';
import { mapBias } from '../lib/geo';
import Icon from './Icon.astro';

interface Props { settings: Settings; cars: Car[]; refCode: string; defaultPickup?: string; defaultDest?: string; defaultCar?: string; destLabel?: string; /** City code (Sanity) that place suggestions and the map start around. */ mapCity?: string }
const lang = langOf(Astro.url.pathname);
const t = ui(lang);
const { settings, cars, refCode, defaultPickup = '', defaultDest = '', defaultCar = '', destLabel = t.bkDest, mapCity } = Astro.props;
const fallback = waHref(settings.waPhone, t.bkMsg.hello, refCode);
// Stable, language-independent keys for the t.bkDurations options (same order
// in id and en; the first option is "not sure yet" and has none).
const durationKeys: (string | undefined)[] = [undefined, '12h', 'allin', 'oneway', 'return', 'multi'];
// Car dropdown: model names without the brand, and the three 7-seat low MPVs
// as one option. Single cars keep their full name as the value (message/lead).
const brand = /^(Toyota|Daihatsu|Suzuki|Mitsubishi|Honda|Isuzu|Nissan|Hyundai|Wuling)\s+/i;
const lowMpv = ['Avanza', 'Xenia', 'Ertiga'];
const lowMpvName = 'Avanza · Xenia · Ertiga';
const carOptions: { value: string; label: string; names: string[] }[] = [];
for (const c of cars) {
  const label = c.name.replace(brand, '');
  if (lowMpv.includes(label)) {
    const group = carOptions.find((o) => o.value === lowMpvName);
    if (group) group.names.push(c.name);
    else carOptions.push({ value: lowMpvName, label: lowMpvName, names: [c.name] });
  } else carOptions.push({ value: c.name, label, names: [c.name] });
}
const uid = 'bk-' + refCode.toLowerCase();
// Optional dashboard endpoint base (no trailing slash); empty turns lead capture off.
const leadsApi = (import.meta.env.PUBLIC_LEADS_API || '').trim().replace(/\/+$/, '');
// Public browser key (HTTP-referrer restricted); empty turns suggestions and the map off.
const mapsKey = (import.meta.env.PUBLIC_GOOGLE_MAPS_KEY || '').trim();
const maps = mapsKey ? JSON.stringify({ key: mapsKey, lang, bias: mapBias(mapCity), msg: t.bkMap, dialog: `${uid}-map` }) : undefined;
const places: { kind: 'pickup' | 'dest'; label: string; attrs: HTMLAttributes<'input'> }[] = [
  { kind: 'pickup', label: t.bkPickup, attrs: { id: `${uid}-pickup`, name: 'pickup', type: 'text', placeholder: t.bkPickupPh, value: defaultPickup, autocomplete: 'street-address', maxlength: '300', required: true } },
  { kind: 'dest', label: destLabel, attrs: { id: `${uid}-dest`, name: 'dest', type: 'text', placeholder: t.bkDestPh, value: defaultDest, maxlength: '300' } },
];
---
<form class="booking" data-booking data-fab-tuck data-phone={settings.waPhone} data-ref={refCode} data-msg={JSON.stringify(t.bkMsg)} data-leads-api={leadsApi || undefined} data-maps={maps} action={fallback} method="get">
  <div class="f w2">
    <label for={`${uid}-name`}>{t.bkName}</label>
    <input id={`${uid}-name`} name="name" type="text" placeholder={t.bkNamePh} autocomplete="name" maxlength="120" required />
  </div>
  <div class="f">
    <label for={`${uid}-date`}>{t.bkDate}</label>
    <input id={`${uid}-date`} name="date" type="date" required />
  </div>
  <div class="f">
    <label for={`${uid}-time`}>{t.bkTime}</label>
    <input id={`${uid}-time`} name="time" type="time" value="08:00" step="900" />
  </div>
  <div class="f w2">
    <label for={`${uid}-car`}>{t.bkUnit}</label>
    <select id={`${uid}-car`} name="car">
      {!carOptions.length && <option value="">{t.bkHelp}</option>}
      {carOptions.map((o) => <option value={o.value} selected={!!defaultCar && (o.value === defaultCar || o.names.includes(defaultCar))}>{o.label}</option>)}
    </select>
  </div>
  {places.map((p) => mapsKey ? (
    <div class="f w2">
      <div class="lab">
        <label for={p.attrs.id}>{p.label}</label>
        <span class="place-chip" data-place-chip={p.kind} hidden><span aria-hidden="true">📍</span> {t.bkMap.pointSet} · <button type="button" data-place-edit data-kind={p.kind} aria-label={`${t.bkMap.edit} · ${p.label}`}>{t.bkMap.edit}</button></span>
      </div>
      <div class="place" data-place={p.kind}>
        <input {...p.attrs} />
        <button type="button" class="place-map" data-place-map data-kind={p.kind} aria-label={`${t.bkMap.open}: ${p.label}`} title={t.bkMap.open} hidden><Icon name="map" size={18} /></button>
        <div class="place-pop" hidden>
          <ul class="place-list" role="listbox" id={`${p.attrs.id}-list`} aria-label={p.label}></ul>
          <p class="place-attr" translate="no">Google Maps</p>
        </div>
        <span class="sr-only" aria-live="polite" data-place-live></span>
      </div>
    </div>
  ) : (
    <div class="f w2">
      <label for={p.attrs.id}>{p.label}</label>
      <input {...p.attrs} />
    </div>
  ))}
  <div class="hp" aria-hidden="true">
    <label for={`${uid}-website`}>Website</label>
    <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="btn btn-wa w2" type="submit" data-cta="booking"><Icon name="wa" />{t.bkSend}</button>
  <details class="more">
    <summary>{t.bkMore}</summary>
    <div class="more-grid">
      <div class="f">
        <label for={`${uid}-pax`}>{t.bkPax}</label>
        <input id={`${uid}-pax`} name="pax" type="number" min="1" max="60" inputmode="numeric" placeholder="4" />
      </div>
      <div class="f">
        <label for={`${uid}-dur`}>{t.bkDuration}</label>
        <select id={`${uid}-dur`} name="duration">
          {t.bkDurations.map((d, i) => <option value={i === 0 ? '' : d} data-key={durationKeys[i]}>{d}</option>)}
        </select>
      </div>
      <div class="f notes">
        <label for={`${uid}-notes`}>{t.bkNotes}</label>
        <input id={`${uid}-notes`} name="notes" type="text" placeholder={t.bkNotesPh} maxlength="500" />
      </div>
    </div>
  </details>
  <p class="hint">{t.bkHint}</p>
</form>
{mapsKey && (
  <dialog class="mp" id={`${uid}-map`} aria-labelledby={`${uid}-map-title`}>
    <div class="mp-head">
      <h2 class="mp-title" id={`${uid}-map-title`} data-mp-title>{t.bkMap.title}</h2>
      <button type="button" class="mp-x" data-mp-close aria-label={t.bkMap.close}>×</button>
    </div>
    <div class="mp-search place">
      <input type="text" data-mp-search placeholder={t.bkMap.search} aria-label={t.bkMap.search} maxlength="300" enterkeyhint="search" />
      <div class="place-pop" hidden>
        <ul class="place-list" role="listbox" id={`${uid}-map-list`} aria-label={t.bkMap.search}></ul>
        <p class="place-attr" translate="no">Google Maps</p>
      </div>
      <span class="sr-only" aria-live="polite" data-place-live></span>
    </div>
    <div class="mp-map">
      <div class="mp-canvas" data-mp-canvas></div>
      <svg class="mp-pin" width="36" height="44" viewBox="0 0 36 44" aria-hidden="true"><path d="M18 43s15-14.2 15-25.5A15 15 0 0 0 3 17.5C3 28.8 18 43 18 43z" fill="#046bd2" stroke="#fff" stroke-width="2"/><circle cx="18" cy="17.5" r="5.5" fill="#fff"/></svg>
    </div>
    <p class="mp-addr" data-mp-addr aria-live="polite">{t.bkMap.hint}</p>
    <p class="mp-err" data-mp-err role="alert" hidden></p>
    <div class="mp-actions">
      <button type="button" class="btn btn-ghost" data-mp-mine hidden><Icon name="pin" />{t.bkMap.mine}</button>
      <button type="button" class="btn btn-blue" data-mp-use>{t.bkMap.use}</button>
    </div>
  </dialog>
)}

<script>
  import { mapsLink, pointOf } from '../lib/placePoint';

  const cookie = (name: string) => {
    const c = document.cookie.split('; ').find((x) => x.startsWith(name + '='));
    return c ? decodeURIComponent(c.slice(name.length + 1)) : '';
  };
  // GA4 ids from its cookies; anything unexpected yields '' (field omitted).
  const gaIds = () => {
    let clientId = '', sessionId = '';
    try {
      const p = cookie('_ga').split('.');
      if (p.length >= 4 && /^\d+$/.test(p[p.length - 2]) && /^\d+$/.test(p[p.length - 1])) clientId = p.slice(-2).join('.');
      const id = String((window as any).arasyaGa4Id || '').replace(/^G-/, '');
      // Without a known ID (e.g. GA4 via GTM only) take the first _ga_<ID> cookie.
      const raw = id ? cookie('_ga_' + id) : (document.cookie.split('; ').find((x) => /^_ga_[A-Z0-9]+=/.test(x)) || '').replace(/^[^=]*=/, '');
      const third = raw.split('.')[2] || '';
      const m = raw.startsWith('GS2.') ? /^s(\d+)/.exec(third) : /^(\d+)$/.exec(third);
      if (m) sessionId = m[1];
    } catch {}
    return { clientId, sessionId };
  };
  // Text/plain body: a "simple" request, so no CORS preflight. Never throws.
  const sendLead = (url: string, body: Record<string, unknown>) => {
    try {
      const data = JSON.stringify(body);
      if (navigator.sendBeacon?.(url, new Blob([data], { type: 'text/plain;charset=UTF-8' }))) return;
      fetch(url, { method: 'POST', body: data, keepalive: true, mode: 'no-cors', headers: { 'Content-Type': 'text/plain' } }).catch(() => {});
    } catch {}
  };

  // Short, non-reversible fingerprint (cyrb53) so the resend key below does not
  // keep names, addresses or map points in sessionStorage.
  const fingerprint = (str: string) => {
    let h1 = 0xdeadbeef, h2 = 0x41c6ce57;
    for (let i = 0; i < str.length; i++) {
      const ch = str.charCodeAt(i);
      h1 = Math.imul(h1 ^ ch, 2654435761);
      h2 = Math.imul(h2 ^ ch, 1597334677);
    }
    h1 = Math.imul(h1 ^ (h1 >>> 16), 2246822507) ^ Math.imul(h2 ^ (h2 >>> 13), 3266489909);
    h2 = Math.imul(h2 ^ (h2 >>> 16), 2246822507) ^ Math.imul(h1 ^ (h1 >>> 13), 3266489909);
    return (4294967296 * (2097151 & h2) + (h1 >>> 0)).toString(36);
  };

  document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((form) => {
    // Place suggestions + map picker: only when the build has a Maps key. The
    // module (and Google's script) load on the first touch of a place field
    // or a map button, never with the page; any failure leaves plain text.
    // (The env check lets builds without a key drop this code entirely.)
    if (import.meta.env.PUBLIC_GOOGLE_MAPS_KEY && form.dataset.maps) {
      type Picker = import('../lib/mapsPicker').Picker | null;
      let picker: Promise<Picker> | undefined;
      const start = () => (picker ||= import('../lib/mapsPicker').then((m) => m.enhance(form)).catch((): Picker => (form.classList.add('maps-off'), null)));
      form.querySelectorAll<HTMLInputElement>('.place input').forEach((input) => {
        input.addEventListener('focus', start, { once: true });
        input.addEventListener('pointerdown', start, { once: true });
      });
      form.querySelectorAll<HTMLElement>('[data-place-map]').forEach((b) => { b.hidden = false; });
      form.addEventListener('click', (ev) => {
        const b = (ev.target as Element).closest<HTMLElement>('[data-place-map], [data-place-edit]');
        if (!b) return;
        start().then((p) => p?.open(b.dataset.kind as 'pickup' | 'dest', b));
      });
    }
    const date = form.querySelector<HTMLInputElement>('input[name=date]');
    if (date && !date.value) {
      // The visitor's own calendar date (toISOString would give the UTC date).
      const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const now = new Date();
      date.min = ymd(now);
      date.value = ymd(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1));
    }
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = new FormData(form);
      const m = JSON.parse(form.dataset.msg || '{}');
      const get = (k: string) => String(f.get(k) || '').trim();
      const tanggal = get('date')
        ? new Date(get('date') + 'T00:00:00').toLocaleDateString(m.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
        : '…';
      // Points chosen from suggestions or the map (only while the text is unchanged).
      const pickupPoint = get('pickup') ? pointOf(form.querySelector('input[name=pickup]')) : undefined;
      const destPoint = get('dest') ? pointOf(form.querySelector('input[name=dest]')) : undefined;
      const lines = [
        m.hello,
        '',
        `${m.name}: ${get('name') || '…'}`,
        `${m.date}: ${tanggal}`,
        `${m.time}: ${get('time') || '…'}`,
        `${m.pickup}: ${get('pickup') || '…'}${pickupPoint ? ` (${mapsLink(pickupPoint)})` : ''}`,
        `${m.dest}: ${get('dest') || '…'}${destPoint ? ` (${mapsLink(destPoint)})` : ''}`,
        `${m.unit}: ${get('car') || m.help}`,
      ];
      if (get('pax')) lines.push(`${m.pax}: ${get('pax')}`);
      if (get('duration')) lines.push(`${m.duration}: ${get('duration')}`);
      if (get('notes')) lines.push(`${m.notes}: ${get('notes')}`);
      // Short code the admin copies into the bookings sheet; the same code goes to GA4.
      const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      // Sending the identical request again in the same visit (WhatsApp didn't
      // open, double tap) reuses its code and is not counted as a second lead.
      // A different map point changes the lines, so it counts as a new request.
      const key = 'arasya-lead:' + fingerprint(lines.join('|'));
      let code = '';
      try { code = sessionStorage.getItem(key) || ''; } catch {}
      const repeat = !!code;
      if (!code) code = 'ARS-' + Array.from(crypto.getRandomValues(new Uint8Array(5)), (b) => alphabet[b % alphabet.length]).join('');
      try { sessionStorage.setItem(key, code); } catch {}
      lines.splice(1, 0, `${m.code}: ${code}`);
      const text = lines.join('\n') + `\n[Ref: ${form.dataset.ref}]`;
      let src = '';
      try { src = sessionStorage.getItem('arasya-campaign') || ''; } catch {}
      const url = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(text + (src ? ` [Src: ${src}]` : ''))}`;
      if (!repeat) (window as any).arasyaTrack?.('generate_lead', { method: 'booking_form', lead_id: code, unit: get('car') || 'any' });
      // Record the lead in the admin dashboard (same once-per-request rule as GA4).
      if (!repeat && form.dataset.leadsApi) {
        try {
          const ga = gaIds();
          const gclid = /(?:^|[\s·])gclid=([^\s·]+)/.exec(src)?.[1] || new URLSearchParams(location.search).get('gclid') || '';
          const pax = parseInt(get('pax'), 10);
          const durationKey = form.querySelector<HTMLSelectElement>('select[name=duration]')?.selectedOptions[0]?.dataset.key || '';
          const body: Record<string, unknown> = {
            lead_code: code, name: get('name'), trip_date: get('date'), pickup_time: get('time'),
            pickup_location: get('pickup'), destination: get('dest'), unit: get('car'),
            passenger_count: pax > 0 ? pax : '', duration: get('duration'), duration_key: durationKey, notes: get('notes'),
            page_path: location.pathname, language: (document.documentElement.lang || '').slice(0, 2),
            campaign: src, gclid, ga_client_id: ga.clientId, ga_session_id: ga.sessionId,
            website: String(f.get('website') || ''),
          };
          // Only when a point was chosen; numbers, ~6 decimals (placePoint.ts).
          if (pickupPoint) Object.assign(body, { pickup_lat: pickupPoint.lat, pickup_lng: pickupPoint.lng, pickup_place_id: pickupPoint.placeId || '', pickup_place_name: pickupPoint.name || '' });
          if (destPoint) Object.assign(body, { destination_lat: destPoint.lat, destination_lng: destPoint.lng, destination_place_id: destPoint.placeId || '', destination_place_name: destPoint.name || '' });
          for (const k in body) if (body[k] === '') delete body[k];
          sendLead(form.dataset.leadsApi + '/api/v1/public/leads', body);
        } catch {}
      }
      const open = (window as any).arasyaOpenWa;
      if (open) open(url); else window.location.href = url;
    });
  });
</script>

<style>
  .booking { background: #fff; border-radius: var(--radius); box-shadow: 0 8px 24px rgba(2, 38, 75, 0.1); border: 1px solid #e3ebf4; padding: 16px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px 10px; align-items: end; }
  .f { display: grid; gap: 5px; min-width: 0; }
  .w2 { grid-column: span 2; }
  label { font: 700 0.7rem/1 var(--text); color: var(--soft); letter-spacing: 0.05em; text-transform: uppercase; }
  input, select { width: 100%; min-width: 0; font: 500 0.95rem/1.2 var(--text); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 11px 12px; background: #fff; transition: border-color 0.15s, box-shadow 0.15s; }
  input:focus, select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(4, 107, 210, 0.15); }
  input:user-invalid { border-color: #c2410c; }
  .btn { height: 44px; }
  .more { grid-column: 1 / -1; }
  .more summary { cursor: pointer; font: 700 0.85rem/1.2 var(--display); color: var(--blue); list-style: none; display: inline-flex; align-items: center; gap: 6px; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; font-size: 1rem; }
  .more[open] summary::before { content: '–'; }
  .more-grid { display: grid; grid-template-columns: 1fr 1.4fr 3fr; gap: 10px; margin-top: 10px; }
  .hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .hint { grid-column: 1 / -1; font-size: 0.8rem; color: var(--soft); margin-top: -4px; }
  /* Place suggestions + map picker (only rendered with a Maps key). */
  .lab { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; min-width: 0; }
  .place-chip { font: 600 0.75rem/1 var(--text); color: var(--deep); white-space: nowrap; }
  .place-chip[hidden] { display: none; }
  .place-chip button { font: inherit; color: var(--blue); background: none; border: 0; padding: 0; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
  .place { position: relative; min-width: 0; }
  .place:has(.place-map:not([hidden])) input { padding-right: 44px; }
  .place-map { position: absolute; right: 4px; top: 50%; transform: translateY(-50%); width: 36px; height: 36px; display: grid; place-items: center; border: 0; border-radius: 6px; background: none; color: var(--soft); cursor: pointer; }
  .place-map:hover, .place-map:focus-visible { color: var(--blue); background: var(--sky); }
  .place-map.on { color: var(--blue); }
  .place-map[hidden], .maps-off .place-map, .maps-off [data-place-edit] { display: none; }
  .place-pop { position: absolute; z-index: 40; left: 0; right: 0; top: calc(100% + 4px); min-width: min(320px, 86vw); background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm); box-shadow: var(--shadow); overflow: hidden; }
  .place-pop[hidden] { display: none; }
  .place-list { list-style: none; margin: 0; padding: 4px 0; }
  .place-list :global(li) { display: grid; gap: 2px; padding: 9px 12px; cursor: pointer; text-align: left; }
  .place-list :global(li[aria-selected='true']) { background: var(--sky); }
  .place-list :global(b) { font: 700 0.9rem/1.25 var(--text); color: var(--ink); }
  .place-list :global(span) { font: 400 0.8rem/1.3 var(--text); color: var(--soft); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Google's attribution for Places data shown without a Google map. */
  .place-attr { margin: 0; padding: 6px 12px 8px; text-align: right; font: 400 12px/1 Roboto, Arial, sans-serif; color: #5e5e5e; border-top: 1px solid #eef1f4; }
  .mp { width: min(720px, calc(100vw - 32px)); height: min(640px, calc(100dvh - 48px)); max-width: none; max-height: none; padding: 0; border: 0; border-radius: var(--radius); box-shadow: var(--shadow); color: var(--ink); overflow: visible; }
  .mp[open] { display: flex; flex-direction: column; }
  .mp::backdrop { background: rgba(1, 24, 48, 0.55); }
  :global(html.mp-lock) { overflow: hidden; }
  .mp-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 12px 8px 16px; }
  .mp-title { margin: 0; font: 700 1rem/1.3 var(--display); color: var(--deep); }
  .mp-x { width: 40px; height: 40px; flex: none; border: 0; border-radius: 50%; background: var(--paper); font-size: 1.5rem; line-height: 1; color: var(--deep); cursor: pointer; }
  .mp-search { padding: 0 16px 10px; }
  .mp-search .place-pop { left: 16px; right: 16px; z-index: 60; }
  .mp-map { position: relative; flex: 1; min-height: 220px; background: var(--paper); }
  .mp-canvas { position: absolute; inset: 0; }
  .mp-pin { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -100%); pointer-events: none; filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.3)); }
  .mp-addr { margin: 0; padding: 10px 16px 0; min-height: 2.6em; font-size: 0.9rem; color: var(--body); }
  .mp-err { margin: 6px 16px 0; padding: 8px 10px; border-radius: var(--radius-sm); background: #fff4ed; color: #9a3412; font-size: 0.85rem; }
  .mp-err[hidden] { display: none; }
  .mp-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 8px; padding: 12px 16px 16px; }
  .mp-actions .btn[hidden] { display: none; }
  .mp-actions .btn:disabled { opacity: 0.6; cursor: progress; }
  /* Phones: a full-screen sheet with the main button in thumb reach. */
  @media (max-width: 640px) {
    .mp { width: 100vw; height: 100dvh; border-radius: 0; margin: 0; inset: 0; }
    .mp-actions { padding-bottom: max(16px, env(safe-area-inset-bottom)); }
    .mp-actions .btn { flex: 1 1 100%; }
  }
  @media (max-width: 920px) {
    .booking { grid-template-columns: repeat(2, minmax(0, 1fr)); }
