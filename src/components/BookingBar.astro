---
/**
 * Booking form. Collects what the admin would otherwise ask one by one
 * (name, date, time, pick-up, destination, car) and sends it as a single
 * structured WhatsApp message. When PUBLIC_LEADS_API is set, the request is
 * also recorded in the admin dashboard (fire-and-forget; WhatsApp never waits
 * on it). Without JS the form falls back to a plain wa.me link.
 */
import type { Car, Settings } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
import { waHref } from '../lib/wa';
import Icon from './Icon.astro';

interface Props { settings: Settings; cars: Car[]; refCode: string; defaultPickup?: string; defaultDest?: string; defaultCar?: string; destLabel?: string }
const t = ui(langOf(Astro.url.pathname));
const { settings, cars, refCode, defaultPickup = '', defaultDest = '', defaultCar = '', destLabel = t.bkDest } = Astro.props;
const fallback = waHref(settings.waPhone, t.bkMsg.hello, refCode);
// Stable, language-independent keys for the t.bkDurations options (same order
// in id and en; the first option is "not sure yet" and has none).
const durationKeys: (string | undefined)[] = [undefined, '12h', 'allin', 'oneway', 'return', 'multi'];
// Car dropdown: model names without the brand, and the three 7-seat low MPVs
// as one option. Single cars keep their full name as the value (message/lead).
const brand = /^(Toyota|Daihatsu|Suzuki|Mitsubishi|Honda|Isuzu|Nissan|Hyundai|Wuling)\s+/i;
const lowMpv = ['Avanza', 'Xenia', 'Ertiga'];
const lowMpvName = 'Avanza · Xenia · Ertiga';
const carOptions: { value: string; label: string; names: string[] }[] = [];
for (const c of cars) {
  const label = c.name.replace(brand, '');
  if (lowMpv.includes(label)) {
    const group = carOptions.find((o) => o.value === lowMpvName);
    if (group) group.names.push(c.name);
    else carOptions.push({ value: lowMpvName, label: lowMpvName, names: [c.name] });
  } else carOptions.push({ value: c.name, label, names: [c.name] });
}
const uid = 'bk-' + refCode.toLowerCase();
// Optional dashboard endpoint base (no trailing slash); empty turns lead capture off.
const leadsApi = (import.meta.env.PUBLIC_LEADS_API || '').trim().replace(/\/+$/, '');
---
<form class="booking" data-booking data-fab-tuck data-phone={settings.waPhone} data-ref={refCode} data-msg={JSON.stringify(t.bkMsg)} data-leads-api={leadsApi || undefined} action={fallback} method="get">
  <div class="f w2">
    <label for={`${uid}-name`}>{t.bkName}</label>
    <input id={`${uid}-name`} name="name" type="text" placeholder={t.bkNamePh} autocomplete="name" maxlength="120" required />
  </div>
  <div class="f">
    <label for={`${uid}-date`}>{t.bkDate}</label>
    <input id={`${uid}-date`} name="date" type="date" required />
  </div>
  <div class="f">
    <label for={`${uid}-time`}>{t.bkTime}</label>
    <input id={`${uid}-time`} name="time" type="time" value="08:00" step="900" />
  </div>
  <div class="f w2">
    <label for={`${uid}-car`}>{t.bkUnit}</label>
    <select id={`${uid}-car`} name="car">
      {!carOptions.length && <option value="">{t.bkHelp}</option>}
      {carOptions.map((o) => <option value={o.value} selected={!!defaultCar && (o.value === defaultCar || o.names.includes(defaultCar))}>{o.label}</option>)}
    </select>
  </div>
  <div class="f w2">
    <label for={`${uid}-pickup`}>{t.bkPickup}</label>
    <input id={`${uid}-pickup`} name="pickup" type="text" placeholder={t.bkPickupPh} value={defaultPickup} autocomplete="street-address" maxlength="300" required />
  </div>
  <div class="f w2">
    <label for={`${uid}-dest`}>{destLabel}</label>
    <input id={`${uid}-dest`} name="dest" type="text" placeholder={t.bkDestPh} value={defaultDest} maxlength="300" />
  </div>
  <div class="hp" aria-hidden="true">
    <label for={`${uid}-website`}>Website</label>
    <input id={`${uid}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <button class="btn btn-wa w2" type="submit" data-cta="booking"><Icon name="wa" />{t.bkSend}</button>
  <details class="more">
    <summary>{t.bkMore}</summary>
    <div class="more-grid">
      <div class="f">
        <label for={`${uid}-pax`}>{t.bkPax}</label>
        <input id={`${uid}-pax`} name="pax" type="number" min="1" max="60" inputmode="numeric" placeholder="4" />
      </div>
      <div class="f">
        <label for={`${uid}-dur`}>{t.bkDuration}</label>
        <select id={`${uid}-dur`} name="duration">
          {t.bkDurations.map((d, i) => <option value={i === 0 ? '' : d} data-key={durationKeys[i]}>{d}</option>)}
        </select>
      </div>
      <div class="f notes">
        <label for={`${uid}-notes`}>{t.bkNotes}</label>
        <input id={`${uid}-notes`} name="notes" type="text" placeholder={t.bkNotesPh} maxlength="500" />
      </div>
    </div>
  </details>
  <p class="hint">{t.bkHint}</p>
</form>

<script>
  const cookie = (name: string) => {
    const c = document.cookie.split('; ').find((x) => x.startsWith(name + '='));
    return c ? decodeURIComponent(c.slice(name.length + 1)) : '';
  };
  // GA4 ids from its cookies; anything unexpected yields '' (field omitted).
  const gaIds = () => {
    let clientId = '', sessionId = '';
    try {
      const p = cookie('_ga').split('.');
      if (p.length >= 4 && /^\d+$/.test(p[p.length - 2]) && /^\d+$/.test(p[p.length - 1])) clientId = p.slice(-2).join('.');
      const id = String((window as any).arasyaGa4Id || '').replace(/^G-/, '');
      // Without a known ID (e.g. GA4 via GTM only) take the first _ga_<ID> cookie.
      const raw = id ? cookie('_ga_' + id) : (document.cookie.split('; ').find((x) => /^_ga_[A-Z0-9]+=/.test(x)) || '').replace(/^[^=]*=/, '');
      const third = raw.split('.')[2] || '';
      const m = raw.startsWith('GS2.') ? /^s(\d+)/.exec(third) : /^(\d+)$/.exec(third);
      if (m) sessionId = m[1];
    } catch {}
    return { clientId, sessionId };
  };
  // Text/plain body: a "simple" request, so no CORS preflight. Never throws.
  const sendLead = (url: string, body: Record<string, unknown>) => {
    try {
      const data = JSON.stringify(body);
      if (navigator.sendBeacon?.(url, new Blob([data], { type: 'text/plain;charset=UTF-8' }))) return;
      fetch(url, { method: 'POST', body: data, keepalive: true, mode: 'no-cors', headers: { 'Content-Type': 'text/plain' } }).catch(() => {});
    } catch {}
  };

  document.querySelectorAll<HTMLFormElement>('form[data-booking]').forEach((form) => {
    const date = form.querySelector<HTMLInputElement>('input[name=date]');
    if (date && !date.value) {
      // The visitor's own calendar date (toISOString would give the UTC date).
      const ymd = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      const now = new Date();
      date.min = ymd(now);
      date.value = ymd(new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1));
    }
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const f = new FormData(form);
      const m = JSON.parse(form.dataset.msg || '{}');
      const get = (k: string) => String(f.get(k) || '').trim();
      const tanggal = get('date')
        ? new Date(get('date') + 'T00:00:00').toLocaleDateString(m.locale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' })
        : '…';
      const lines = [
        m.hello,
        '',
        `${m.name}: ${get('name') || '…'}`,
        `${m.date}: ${tanggal}`,
        `${m.time}: ${get('time') || '…'}`,
        `${m.pickup}: ${get('pickup') || '…'}`,
        `${m.dest}: ${get('dest') || '…'}`,
        `${m.unit}: ${get('car') || m.help}`,
      ];
      if (get('pax')) lines.push(`${m.pax}: ${get('pax')}`);
      if (get('duration')) lines.push(`${m.duration}: ${get('duration')}`);
      if (get('notes')) lines.push(`${m.notes}: ${get('notes')}`);
      // Short code the admin copies into the bookings sheet; the same code goes to GA4.
      const alphabet = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
      // Sending the identical request again in the same visit (WhatsApp didn't
      // open, double tap) reuses its code and is not counted as a second lead.
      const key = 'arasya-lead:' + lines.join('|');
      let code = '';
      try { code = sessionStorage.getItem(key) || ''; } catch {}
      const repeat = !!code;
      if (!code) code = 'ARS-' + Array.from(crypto.getRandomValues(new Uint8Array(5)), (b) => alphabet[b % alphabet.length]).join('');
      try { sessionStorage.setItem(key, code); } catch {}
      lines.splice(1, 0, `${m.code}: ${code}`);
      const text = lines.join('\n') + `\n[Ref: ${form.dataset.ref}]`;
      let src = '';
      try { src = sessionStorage.getItem('arasya-campaign') || ''; } catch {}
      const url = `https://wa.me/${form.dataset.phone}?text=${encodeURIComponent(text + (src ? ` [Src: ${src}]` : ''))}`;
      if (!repeat) (window as any).arasyaTrack?.('generate_lead', { method: 'booking_form', lead_id: code, unit: get('car') || 'any' });
      // Record the lead in the admin dashboard (same once-per-request rule as GA4).
      if (!repeat && form.dataset.leadsApi) {
        try {
          const ga = gaIds();
          const gclid = /(?:^|[\s·])gclid=([^\s·]+)/.exec(src)?.[1] || new URLSearchParams(location.search).get('gclid') || '';
          const pax = parseInt(get('pax'), 10);
          const durationKey = form.querySelector<HTMLSelectElement>('select[name=duration]')?.selectedOptions[0]?.dataset.key || '';
          const body: Record<string, unknown> = {
            lead_code: code, name: get('name'), trip_date: get('date'), pickup_time: get('time'),
            pickup_location: get('pickup'), destination: get('dest'), unit: get('car'),
            passenger_count: pax > 0 ? pax : '', duration: get('duration'), duration_key: durationKey, notes: get('notes'),
            page_path: location.pathname, language: (document.documentElement.lang || '').slice(0, 2),
            campaign: src, gclid, ga_client_id: ga.clientId, ga_session_id: ga.sessionId,
            website: String(f.get('website') || ''),
          };
          for (const k in body) if (body[k] === '') delete body[k];
          sendLead(form.dataset.leadsApi + '/api/v1/public/leads', body);
        } catch {}
      }
      const open = (window as any).arasyaOpenWa;
      if (open) open(url); else window.location.href = url;
    });
  });
</script>

<style>
  .booking { background: #fff; border-radius: var(--radius); box-shadow: 0 8px 24px rgba(2, 38, 75, 0.1); border: 1px solid #e3ebf4; padding: 16px; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px 10px; align-items: end; }
  .f { display: grid; gap: 5px; min-width: 0; }
  .w2 { grid-column: span 2; }
  label { font: 700 0.7rem/1 var(--text); color: var(--soft); letter-spacing: 0.05em; text-transform: uppercase; }
  input, select { width: 100%; min-width: 0; font: 500 0.95rem/1.2 var(--text); color: var(--ink); border: 1px solid var(--line); border-radius: var(--radius-sm); padding: 11px 12px; background: #fff; transition: border-color 0.15s, box-shadow 0.15s; }
  input:focus, select:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px rgba(4, 107, 210, 0.15); }
  input:user-invalid { border-color: #c2410c; }
  .btn { height: 44px; }
  .more { grid-column: 1 / -1; }
  .more summary { cursor: pointer; font: 700 0.85rem/1.2 var(--display); color: var(--blue); list-style: none; display: inline-flex; align-items: center; gap: 6px; }
  .more summary::-webkit-details-marker { display: none; }
  .more summary::before { content: '+'; font-size: 1rem; }
  .more[open] summary::before { content: '–'; }
  .more-grid { display: grid; grid-template-columns: 1fr 1.4fr 3fr; gap: 10px; margin-top: 10px; }
  .hp { position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden; }
  .hint { grid-column: 1 / -1; font-size: 0.8rem; color: var(--soft); margin-top: -4px; }
  @media (max-width: 920px) {
    .booking { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .w2, .btn { grid-column: 1 / -1; }
    .more-grid { grid-template-columns: 1fr 1fr; }
    .more-grid .notes { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) { .booking { gap: 10px 8px; padding: 12px; } label { font-size: 0.66rem; } input, select { padding: 10px; font-size: 0.9rem; } }
</style>
