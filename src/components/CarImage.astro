---
import { carImage } from '../lib/images';
import type { Car } from '../lib/content';
interface Props { car?: Car | null; sizes?: string; eager?: boolean; class?: string }
const { car, sizes = '(max-width: 560px) 90vw, 300px', eager = false, class: cls } = Astro.props;
const img = carImage(car);
---
{img && car && (
  <img class={cls} src={img.src} srcset={img.srcset} sizes={sizes} alt={car.name} width="960" height="600"
    loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : undefined} decoding="async" />
)}
