---
import type { Settings } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
import { waHref } from '../lib/wa';
import Icon from './Icon.astro';
interface Props { settings: Settings; title: string; text?: string; message: string; waRef: string }
const { settings, title, text, message, waRef } = Astro.props;
const t = ui(langOf(Astro.url.pathname));
---
<section class="band">
  <div class="wrap inner">
    <div class="stack"><h2>{title}</h2>{text && <p>{text}</p>}</div>
    <div class="acts">
      <a class="btn btn-light" href={waHref(settings.waPhone, message, waRef)} data-cta={`band-${waRef}`} rel="nofollow"><Icon name="wa" />{t.bandBtn}</a>
      <span class="num">{t.bandCall(settings.phones[0])}</span>
    </div>
  </div>
</section>
<style>
  .band { background: var(--blue); color: #fff; padding-block: 44px; }
  .inner { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  h2 { color: #fff; }
  p { color: #e8f2fd; max-width: 56ch; }
  .btn-light { background: #fff; color: var(--deep); }
  .btn-light:hover { background: var(--sky); color: var(--deep); }
  .btn-light :global(svg) { color: #1fa855; }
  .acts { display: grid; gap: 8px; justify-items: start; font-size: 0.9rem; color: #e8f2fd; }
</style>
