---
import type { Faq } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
interface Props { items: Faq[]; title?: string }
const { items, title = ui(langOf(Astro.url.pathname)).faqTitle } = Astro.props;
---
{items.length > 0 && (
  <section class="section" aria-labelledby="faq-title">
    <div class="wrap faq-grid">
      <div class="stack">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">{title}</h2>
      </div>
      <div class="list">
        {items.map((f, i) => (
          <details open={i === 0}>
            <summary><h3>{f.question}</h3></summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .faq-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 32px; align-items: start; }
  .list { display: grid; gap: 10px; }
  details { border: 1px solid var(--line); border-radius: var(--radius); padding: 4px 18px; background: #fff; }
  details[open] { border-color: var(--sky-2); background: var(--paper); }
  summary { cursor: pointer; list-style: none; padding: 14px 0; display: flex; justify-content: space-between; gap: 12px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; font: 700 1.3rem/1 var(--display); color: var(--blue); }
  details[open] summary::after { content: '–'; }
  summary h3 { font-size: 1.02rem; }
  details p { padding-bottom: 16px; color: var(--soft); max-width: 70ch; }
  @media (max-width: 860px) { .faq-grid { grid-template-columns: 1fr; } }
</style>
