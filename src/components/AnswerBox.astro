---
/**
 * "Jawaban singkat": a plain, factual answer near the top of the page. Short
 * self-contained statements like this are what search snippets and AI answer
 * engines lift, so they should carry numbers and place names, not slogans.
 */
interface Props { question: string; answer: string; updated?: string }
const { question, answer, updated } = Astro.props;
---
<section class="answer" aria-labelledby="answer-q">
  <h2 id="answer-q" class="q">{question}</h2>
  <p class="a">{answer}</p>
  {updated && <p class="upd">Diperbarui {updated}</p>}
</section>
<style>
  .answer { border-left: 4px solid var(--blue); background: var(--paper); border-radius: 0 var(--radius) var(--radius) 0; padding: 18px 22px; display: grid; gap: 6px; max-width: 80ch; }
  .q { font: 700 1.05rem/1.3 var(--display); color: var(--deep); }
  .a { color: var(--ink); }
  .upd { font-size: 0.8rem; color: var(--soft); }
</style>
