---
import type { TitledText } from '../lib/content';
import { langOf, ui } from '../lib/i18n';
interface Props { items: TitledText[]; title?: string }
const t = ui(langOf(Astro.url.pathname));
const { items, title = t.stepsTitle } = Astro.props;
---
{items.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head"><div class="stack"><span class="eyebrow">{t.stepsEyebrow}</span><h2>{title}</h2></div></div>
      <ol class="steps">
        {items.map((s, i) => (
          <li><span class="n num">{i + 1}</span><div><h3>{s.title}</h3>{s.text && <p>{s.text}</p>}</div></li>
        ))}
      </ol>
    </div>
  </section>
)}
<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  li { display: grid; grid-template-columns: 40px 1fr; gap: 14px; align-items: start; padding: 18px; border-radius: var(--radius); background: var(--paper); }
  .n { width: 40px; height: 40px; border-radius: 50%; background: var(--blue); color: #fff; display: grid; place-items: center; font: 800 1rem/1 var(--display); }
  p { color: var(--soft); font-size: 0.95rem; margin-top: 4px; }
</style>
