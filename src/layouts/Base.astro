---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WaFab from '../components/WaFab.astro';
import { getContent } from '../lib/content';
import { graph, organization, priceRange } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  jsonld?: (object | null | undefined)[];
  ogImage?: string;
  waMessage?: string;
  waRef?: string;
}

const { title, description, path, noindex = false, jsonld = [], ogImage = '/og-default.png', waMessage, waRef } = Astro.props;
const content = await getContent();
const site = (Astro.site?.toString() || content.settings.siteUrl).replace(/\/$/, '');
const canonical = site + (path === '/' ? '' : path);
const org = { ...organization(content.settings, site, content.cities.map((c) => c.name)), priceRange: priceRange(content.cars) };
const ld = graph({ '@type': 'WebSite', '@id': `${site}/#website`, url: site, name: content.settings.brandName, inLanguage: 'id-ID' }, org, ...jsonld);
const gtm = import.meta.env.PUBLIC_GTM_ID;
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:site_name" content={content.settings.brandName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={site + ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#046bd2" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Ringkasan untuk AI" />
    <slot name="head" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {gtm && (
      <script is:inline define:vars={{ gtm }}>
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        var s = document.createElement('script'); s.async = true; s.src = 'https://www.googletagmanager.com/gtm.js?id=' + gtm;
        document.head.appendChild(s);
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">Langsung ke konten</a>
    <Header content={content} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer content={content} />
    <WaFab phone={content.settings.waPhone} message={waMessage} waRef={waRef} />
    <script is:inline>
      /* Campaign attribution + CTA analytics. Captures utm/gclid on landing,
         keeps them for the session, and appends them to every WhatsApp link so
         the admin sees which ad a chat came from. */
      (function () {
        var KEY = 'arasya-campaign', tag = '';
        try {
          var q = new URLSearchParams(location.search), parts = [];
          ['utm_source', 'utm_medium', 'utm_campaign', 'gclid', 'fbclid'].forEach(function (k) { if (q.get(k)) parts.push(k.replace('utm_', '') + '=' + q.get(k)); });
          if (parts.length) sessionStorage.setItem(KEY, parts.join(' · '));
          tag = sessionStorage.getItem(KEY) || '';
        } catch (e) {}
        document.addEventListener('click', function (ev) {
          var a = ev.target.closest && ev.target.closest('a[href^="https://wa.me/"]');
          if (!a) return;
          if (tag && a.href.indexOf('%5BSrc%3A') < 0) {
            var u = new URL(a.href);
            u.searchParams.set('text', (u.searchParams.get('text') || '') + ' [Src: ' + tag + ']');
            a.href = u.toString();
          }
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'cta_click', cta: a.dataset.cta || 'wa', page: location.pathname });
        }, true);
      })();
    </script>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: 8px; top: -60px; z-index: 100; background: var(--deep); color: #fff; padding: 10px 14px; border-radius: 8px; }
  .skip:focus { top: 8px; }
</style>
