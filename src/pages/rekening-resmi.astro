---
/**
 * Verification page people land on when they search "arasya rent car
 * penipuan" or want to double-check an account before paying.
 */
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FraudNotice from '../components/FraudNotice.astro';
import Faq from '../components/Faq.astro';
import { getContent } from '../lib/content';
import { breadcrumbs, faqPage } from '../lib/schema';

const { settings } = await getContent();
const site = (Astro.site?.toString() || settings.siteUrl).replace(/\/$/, '');
const crumbs = [{ name: 'Beranda', path: '/' }, { name: 'Nomor & rekening resmi', path: '/rekening-resmi' }];
const bank = settings.bankAccounts[0];
const faq = [
  { question: 'Berapa nomor WhatsApp resmi Arasya Rent Car?', answer: `Nomor resmi Arasya Rent Car: ${settings.phones.join(', ')}. Di luar nomor tersebut bukan dari kami.` },
  ...(bank ? [{ question: 'Ke rekening mana pembayaran Arasya Rent Car?', answer: `Hanya ke rekening ${bank.bank} ${bank.number} ${bank.owner}. Kami tidak menerima pembayaran ke rekening pribadi.` }] : []),
  { question: 'Apa yang harus saya lakukan kalau diminta transfer ke rekening lain?', answer: `Jangan transfer. Hubungi nomor resmi kami (${settings.phones[0]}) untuk memastikan, dan laporkan nomor atau rekening tersebut kepada kami.` },
];
---
<Base title="Nomor & Rekening Resmi Arasya Rent Car — Waspada Penipuan" description={`Nomor WhatsApp dan rekening resmi Arasya Rent Car (${settings.legalName}). Cocokkan sebelum transfer; kami tidak pernah meminta transfer ke rekening pribadi.`} path="/rekening-resmi" jsonld={[faqPage(faq), breadcrumbs(site, crumbs)]} waRef="VERIF-fab">
  <section class="head">
    <div class="wrap stack">
      <Breadcrumbs items={crumbs} />
      <p class="lead">Ada penipu yang memakai nama rental mobil untuk meminta transfer. Halaman ini berisi nomor dan rekening resmi {settings.brandName}, dikelola {settings.legalName}.</p>
    </div>
  </section>
  <section class="section" style="padding-top:28px">
    <div class="wrap stack">
      <FraudNotice settings={settings} heading="h1" withLink={false} />
      <div class="steps">
        <h2>Cara memastikan sebelum transfer</h2>
        <ol>
          <li>Pastikan chat datang dari salah satu nomor resmi di atas.</li>
          <li>Cocokkan nama penerima di aplikasi bank: harus <b>{bank?.owner.replace(/^a\.n\.\s*/i, '') || settings.legalName}</b>.</li>
          <li>Minta invoice resmi sebelum membayar DP.</li>
          <li>Kalau ada yang janggal, telepon {settings.phones[0]} dulu.</li>
        </ol>
      </div>
    </div>
  </section>
  <Faq items={faq} title="Tanya jawab verifikasi" />
</Base>
<style>
  .head { background: var(--paper); padding-block: 24px 24px; border-bottom: 1px solid var(--line); }
  .steps { display: grid; gap: 12px; max-width: 72ch; margin-top: 12px; }
  .steps h2 { font-size: 1.35rem; }
  .steps ol { margin: 0; padding-left: 1.3em; display: grid; gap: 8px; color: var(--body); }
</style>
