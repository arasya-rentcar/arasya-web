# Canonical domain (no trailing slash). Defaults to https://arasyarentcar.com.
SITE_URL=

# Set to 1 on production so a Sanity outage fails the build instead of
# silently publishing the bundled seed content.
CONTENT_STRICT=

# Only needed if the dataset is made private.
SANITY_READ_TOKEN=

# Only for scripts/seed-sanity.mjs (Editor permission). Never commit it.
SANITY_API_TOKEN=

# Optional: GA4 / Google Tag Manager container, e.g. GTM-XXXXXXX
PUBLIC_GTM_ID=

# Optional: base URL of the admin dashboard API (no trailing slash), e.g.
# https://api.example.com. When set, booking-form leads are also POSTed to
# {PUBLIC_LEADS_API}/api/v1/public/leads. Leave empty to send nothing.
PUBLIC_LEADS_API=

# Optional: map provider for the booking form's place suggestions and map
# picker: osm (OpenStreetMap: Photon + Leaflet/OSM tiles, no key) or google
# (needs PUBLIC_GOOGLE_MAPS_KEY). Empty or anything else: feature off (plain
# text fields). Production sets osm in .env.production; environment variables
# (e.g. Vercel project settings) take precedence over that file. To switch
# production to Google: set PUBLIC_MAPS_PROVIDER=google and
# PUBLIC_GOOGLE_MAPS_KEY in Vercel (Production), then redeploy. To turn it
# off in production (e.g. Photon or the tile server blocks us), set
# PUBLIC_MAPS_PROVIDER=off in Vercel and redeploy.
PUBLIC_MAPS_PROVIDER=

# Google Maps Platform browser key, used only with PUBLIC_MAPS_PROVIDER=google.
# Public (it ends up in the page): restrict it to the site's HTTP referrers and
# to Maps JavaScript API, Places API (New) and Geocoding API only.
PUBLIC_GOOGLE_MAPS_KEY=
